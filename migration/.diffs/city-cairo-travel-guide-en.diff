+         },
+         {
+           "_key": "5f4446a03cc1",
+           "_type": "span",
+           "marks": [],
+           "text": " complex and the historic ruins of "
+         },
+         {
+           "_key": "f374222b3aff",
+           "_type": "span",
+           "marks": [
+             "11354af85b8d"
+           ],
+           "text": "Memphis"
+         },
+         {
+           "_key": "81244a086ada",
+           "_type": "span",
+           "marks": [],
+           "text": " nestled within its embrace."
+         }
+       ],
+       "markDefs": [
