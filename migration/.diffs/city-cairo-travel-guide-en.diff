+         },
+         {
+           "_key": "57ccc1b6cbd4",
+           "_type": "span",
+           "marks": [],
+           "text": " complex and the historic ruins of "
+         },
+         {
+           "_key": "7b1db6cd9a80",
+           "_type": "span",
+           "marks": [
+             "71b156037299"
+           ],
+           "text": "Memphis"
+         },
+         {
+           "_key": "c3227f1a3b9d",
+           "_type": "span",
+           "marks": [],
+           "text": " nestled within its embrace."
+         }
