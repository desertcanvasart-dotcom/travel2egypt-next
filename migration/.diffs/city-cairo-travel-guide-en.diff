+       "style": "normal"
+     },
+     {
+       "_key": "ebd846293947",
+       "_type": "block",
+       "children": [
+         {
+           "_key": "ff710e616f9e",
+           "_type": "span",
+           "marks": [],
+           "text": "The vibrant tapestry of Cairo’s history is further adorned with Coptic Cairo, home to iconic Coptic landmarks like the famous "
+         },
+         {
+           "_key": "347b77893f55",
+           "_type": "span",
+           "marks": [
+             "782da7c95e07"
+           ],
+           "text": "Hanging Church"
+         },
+         {
+           "_key": "3e9ea9ffca98",
+           "_type": "span",
+           "marks": [],
+           "text": " and the Coptic Museum. For a taste of Cairo’s bustling market life, Khan El Khalili stands as the most renowned tourist market globally."
+         }
+       ],
+       "markDefs": [
+         {
+           "_key": "782da7c95e07",
+           "_pendingInternalRef": {
+             "sourceLocale": "en",
+             "wpUrl": "http://travel2egypt.org/cairo/the-hanging-church/"
+           },
+           "_type": "externalLink",
+           "href": "http://travel2egypt.org/cairo/the-hanging-church/",
+           "newTab": false
+         }
+       ],
+       "style": "normal"
+     },
+     {
+       "_key": "320d502a5a67",
+       "_type": "block",
+       "children": [
+         {
+           "_key": "82d31cfd4b2c",
+           "_type": "span",
+           "marks": [],
+           "text": "Cairo is also the cradle of the oldest and most influential film and music industries in the Arab world, alongside hosting Al-Azhar University, the world’s second-oldest institution of higher learning. With many international media and organizations setting their regional headquarters here, and the Arab League calling Cairo home for much of its history, the city is a dynamic nexus of global and regional influence."
+         }
+       ],
+       "markDefs": [],
+       "style": "normal"
+     },
+     {
+       "_key": "1f743a60cd9b",
+       "_type": "block",
+       "children": [
+         {
+           "_key": "6b57c9049563",
+           "_type": "span",
+           "marks": [],
+           "text": "Explore Cairo, where history and modernity converge, offering a journey through time and an embrace of the new. This city is not just a destination but a vibrant chapter in the story of civilization."
+         }
+       ],
+       "markDefs": [],
+       "style": "normal"
