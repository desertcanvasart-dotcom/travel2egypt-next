+           "_type": "span",
+           "marks": [],
+           "text": "La transformación de Akhmim en una localidad moderna no ha diluido su esencia histórica."
+         },
+         {
+           "_key": "f7bd5ed4e8da",
+           "_type": "span",
+           "marks": [],
