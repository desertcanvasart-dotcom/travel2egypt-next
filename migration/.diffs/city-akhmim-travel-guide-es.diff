+           "text": "\n"
+         },
+         {
+           "_key": "fc756c5a7074",
+           "_type": "span",
+           "marks": [],
+           "text": " Los mercados cercanos al museo al aire libre son un testimonio de ello, ya que ofrecen una visión de la artesanía especializada que define a Akhmim."
+         },
+         {
+           "_key": "57e4f3659186",
+           "_type": "span",
+           "marks": [],
+           "text": "\n"
+         },
+         {
+           "_key": "2d5fbf9c700f",
+           "_type": "span",
+           "marks": [],
+           "text": " Aquí, los "
