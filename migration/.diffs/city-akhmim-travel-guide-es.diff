+           "_type": "span",
+           "marks": [
+             "e83d20b889ed"
+           ],
+           "text": "Sigue siendo"
+         },
+         {
+           "_key": "b99782ba939f",
+           "_type": "span",
+           "marks": [],
+           "text": " un bastión del tejido y la tapicería tradicionales, una forma de arte que es fundamental para su identidad."
