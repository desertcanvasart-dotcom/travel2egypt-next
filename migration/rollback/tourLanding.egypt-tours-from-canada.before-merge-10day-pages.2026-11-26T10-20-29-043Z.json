 "faq": [
  {
   "_key": "faq-canada-1",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b23",
       "_type": "block",
       "children": [
        {
         "_key": "s24",
         "_type": "span",
         "marks": [],
         "text": "Yes. Canadian passport holders need a tourist visa. You can apply for an e-visa in advance or get a 30-day tourist visa on arrival, usually paid in US-dollar cash. Rules change, so check Egypt’s official e-visa site and Canadian government travel advice before you go."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do Canadians need a visa for Egypt?"
    }
   ]
  },
  {
   "_key": "faq-canada-2",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b25",
       "_type": "block",
       "children": [
        {
         "_key": "s26",
         "_type": "span",
         "marks": [],
         "text": "EgyptAir flies direct from Toronto Pearson to Cairo. From other Canadian cities, you’ll connect through Toronto, Europe or the Middle East."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Is there a direct flight from Canada?"
    }
   ]
  },
  {
   "_key": "faq-canada-3",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b27",
       "_type": "block",
       "children": [
        {
         "_key": "s28",
         "_type": "span",
         "marks": [],
         "text": "Yes. Christmas, New Year and Easter are peak dates in Egypt. Scheduled departures on those dates usually cost 30% more, and private journeys cost more over the same dates too."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do prices change by season?"
    }
   ]
  }
 ],
 "intro": [
  {
   "_key": "en",
   "value": [
    {
     "_key": "b1v",
     "_type": "block",
     "children": [
      {
       "_key": "s1w",
       "_type": "span",
       "marks": [],
       "text": "Planning the trip from Canada"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "b1x",
     "_type": "block",
     "children": [
      {
       "_key": "s1y",
       "_type": "span",
       "marks": [],
       "text": "EgyptAir flies direct from Toronto Pearson to Cairo. From Montreal, Vancouver, Calgary or Ottawa, travellers compare connections through Toronto, Europe or the Middle East, and the transfer time and arrival hour matter more than the airline."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b1z",
     "_type": "block",
     "children": [
      {
       "_key": "s20",
       "_type": "span",
       "marks": [],
       "text": "A workable first trip: two or three nights in Cairo, two or three in Luxor, three or four for a Nile cruise or Aswan, and two or three on the Red Sea at the end."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b21",
     "_type": "block",
     "children": [
      {
       "_key": "s22",
       "_type": "span",
       "marks": [],
       "text": "October to April is the easiest window. February is a particularly good choice from Canada: you leave the cold behind and find walkable temperatures for sightseeing."
      }
     ],
     "markDefs": [],
     "style": "normal"
    }
   ]
  }
 ],
