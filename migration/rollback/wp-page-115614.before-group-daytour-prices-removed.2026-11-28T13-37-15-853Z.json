   "_ref": "image-a359648be9195a545f29f6d421111411c35c36e6-3000x1999-jpg",
   "_type": "reference"
  },
  "caption": [
   {
    "_key": "en",
    "_type": "object",
    "value": "Vivid burial-chamber paintings surround a broken sarcophagus deep in a Valley of the Kings tomb."
   },
   {
    "_key": "es",
    "_type": "object",
    "value": "Pinturas funerarias vívidas rodean un sarcófago roto en una tumba del Valle de los Reyes."
   },
   {
