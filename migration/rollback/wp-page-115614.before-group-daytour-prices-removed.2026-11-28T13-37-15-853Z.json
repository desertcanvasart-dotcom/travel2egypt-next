     "_key": "00000000000c",
     "_type": "block",
     "children": [
      {
       "_key": "000000000000",
       "_type": "span",
       "marks": [],
       "text": "Join us for an unforgettable journey through the heart of "
      },
      {
       "_key": "000000000002",
       "_type": "span",
       "marks": [
        "000000000001"
       ],
       "text": "ancient Egypt"
      },
      {
       "_key": "000000000003",
       "_type": "span",
       "marks": [],
       "text": " with our group tour,"
      },
      {
       "_key": "000000000004",
       "_type": "span",
       "marks": [
        "strong"
       ],
       "text": " \"Safaga to Luxor: Full Day Group Ancient City Adventure,\""
      },
      {
       "_key": "000000000005",
       "_type": "span",
       "marks": [],
       "text": " that uncovers the treasures of "
      },
      {
       "_key": "000000000007",
       "_type": "span",
       "marks": [
        "000000000006"
       ],
       "text": "Luxor’s"
      },
      {
       "_key": "000000000008",
       "_type": "span",
       "marks": [],
       "text": " east and west banks. This well-crafted excursion offers a comprehensive exploration of Luxor’s most important archaeological sites, from the royal tombs in "
      },
      {
       "_key": "00000000000a",
       "_type": "span",
       "marks": [
        "000000000009"
       ],
       "text": "the Valley of the Kings"
      },
      {
       "_key": "00000000000b",
       "_type": "span",
       "marks": [],
       "text": " to the grandeur of Karnak and Luxor Temples. Experience the awe-inspiring legacy of the Pharaohs, brought to life through stories and structures that have withstood the test of time."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000001",
       "_type": "externalLink",
       "href": "https://en.wikipedia.org/wiki/Ancient_Egypt",
       "newTab": false
