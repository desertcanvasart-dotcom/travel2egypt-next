  {
   "_key": "00000000009e",
   "_type": "block",
   "children": [
    {
     "_key": "000000000093",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "Saladin Citadel"
    },
    {
     "_key": "000000000094",
     "_type": "span",
     "marks": [],
     "text": "\n"
    },
    {
     "_key": "000000000095",
     "_type": "span",
     "marks": [],
     "text": "After the museum, journey to the historic "
    },
    {
     "_key": "000000000097",
     "_type": "span",
     "marks": [
      "strong",
      "000000000096"
     ],
     "text": "Citadel of Saladin"
    },
    {
     "_key": "000000000098",
     "_type": "span",
     "marks": [],
     "text": ", a fortress that has stood since 1176 as a stronghold protecting Cairo. Discover the stunning "
    },
    {
     "_key": "000000000099",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "Mosque of Mohamed Ali"
    },
    {
     "_key": "00000000009a",
     "_type": "span",
     "marks": [],
     "text": ", also known as the Alabaster Mosque, renowned for its impressive Ottoman architecture and breathtaking views over the city. Walk through the "
    },
    {
     "_key": "00000000009c",
     "_type": "span",
     "marks": [
      "strong",
      "00000000009b"
     ],
     "text": "Military Museum"
    },
    {
     "_key": "00000000009d",
     "_type": "span",
     "marks": [],
     "text": " within the Citadel to learn more about Egypt’s defense history, and enjoy the striking combination of medieval engineering and Islamic artistry that defines this landmark."
    }
   ],
   "markDefs": [
    {
