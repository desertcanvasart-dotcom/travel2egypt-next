   "children": [
    {
     "_key": "000000000089",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "Egyptian Museum of Antiquities"
    },
    {
     "_key": "00000000008a",
     "_type": "span",
     "marks": [],
     "text": "\n"
    },
    {
     "_key": "00000000008b",
     "_type": "span",
     "marks": [],
     "text": "Begin your day with a visit to the "
    },
    {
     "_key": "00000000008c",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "Egyptian Museum"
    },
    {
     "_key": "00000000008d",
     "_type": "span",
     "marks": [],
     "text": ", home to the world’s largest and most comprehensive collection of ancient Egyptian artifacts. Explore the museum’s vast galleries filled with treasures from Egypt’s illustrious history, including the famous "
    },
    {
     "_key": "00000000008e",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "golden mask and artifacts of Tutankhamun"
    },
    {
     "_key": "00000000008f",
     "_type": "span",
     "marks": [],
     "text": ", statues, and the "
    },
    {
     "_key": "000000000090",
     "_type": "span",
     "marks": [
      "strong"
     ],
     "text": "royal mummies"
    },
    {
     "_key": "000000000091",
     "_type": "span",
     "marks": [],
     "text": ". Gain insights into the lives of Egypt’s pharaohs and explore the remarkable craftsmanship that has fascinated the world for centuries."
    }
   ],
