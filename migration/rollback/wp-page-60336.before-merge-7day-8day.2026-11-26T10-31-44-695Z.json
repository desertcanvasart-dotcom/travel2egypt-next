       "_type": "span",
       "marks": [],
       "text": "Culinary Experiences in "
      },
      {
       "_key": "33nywvpgkd3u",
       "_type": "span",
       "marks": [
        "rjf944j2ebgc"
       ],
       "text": "Qena"
      }
     ],
     "markDefs": [
      {
       "_key": "rjf944j2ebgc",
       "_type": "internalLink",
       "reference": {
        "_ref": "wp-page-58902",
