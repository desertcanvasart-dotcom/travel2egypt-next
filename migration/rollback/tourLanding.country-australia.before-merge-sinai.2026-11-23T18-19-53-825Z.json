 },
 "faq": [
  {
   "_key": "faq-australia-1",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b22",
       "_type": "block",
       "children": [
        {
         "_key": "s23",
         "_type": "span",
         "marks": [],
         "text": "Australians can get a visa on arrival in Egypt. Rules and fees change, so check Egypt’s official e-visa site and Smartraveller before you go."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do Australians need a visa for Egypt?"
    }
   ]
  },
  {
   "_key": "faq-australia-2",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b24",
       "_type": "block",
       "children": [
        {
         "_key": "s25",
         "_type": "span",
         "marks": [],
         "text": "Usually, yes. After a long journey with a connection, a night in Cairo before heading south is easier than travelling on the same day."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Should we rest in Cairo after arriving?"
    }
   ]
  },
  {
   "_key": "faq-australia-3",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b26",
       "_type": "block",
       "children": [
        {
         "_key": "s27",
         "_type": "span",
         "marks": [],
         "text": "Yes. Christmas, New Year and Easter are peak dates in Egypt. Scheduled departures on those dates usually cost 30% more, and private journeys cost more over the same dates too."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do prices change by season?"
    }
   ]
  }
 ],
 "intro": [
  {
   "_key": "en",
   "value": [
    {
     "_key": "b1u",
     "_type": "block",
     "children": [
      {
       "_key": "s1v",
       "_type": "span",
       "marks": [],
       "text": "Planning the trip from Australia"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "b1w",
     "_type": "block",
     "children": [
      {
       "_key": "s1x",
       "_type": "span",
       "marks": [],
       "text": "Most flights from Australia to Egypt connect through Doha, Dubai or Kuala Lumpur. Check the connection time and the arrival hour in Cairo, not just the airline: after a late-night arrival, treat the first day as rest."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b1y",
     "_type": "block",
     "children": [
      {
       "_key": "s1z",
       "_type": "span",
       "marks": [],
       "text": "Seven days is the shortest trip that connects Cairo with Luxor and Aswan properly. Ten days adds Abu Simbel and time to go deeper at each place."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b20",
     "_type": "block",
     "children": [
      {
       "_key": "s21",
       "_type": "span",
       "marks": [],
       "text": "October to April is the comfortable season for sightseeing. December and January are the busiest and cost more."
      }
     ],
     "markDefs": [],
     "style": "normal"
    }
   ]
  }
 ],
