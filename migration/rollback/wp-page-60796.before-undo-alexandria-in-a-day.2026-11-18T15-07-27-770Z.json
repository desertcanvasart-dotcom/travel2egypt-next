       "text": "Monasterio de San Pishoy en Wadi El Natrun"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "00000000000a",
     "_type": "block",
     "children": [
      {
       "_key": "000000000002",
       "_type": "span",
       "marks": [],
       "text": "El Monasterio de San Pishoy, situado en Wadi El Natrun, Gobernación de Beheira, "
      },
      {
       "_key": "000000000004",
       "_type": "span",
       "marks": [],
       "text": "Egipto"
      },
      {
       "_key": "000000000005",
       "_type": "span",
       "marks": [],
       "text": ", es un centro espiritual clave para la Iglesia Ortodoxa Copta de Alejandría."
      },
      {
       "_key": "000000000006",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "000000000007",
       "_type": "span",
       "marks": [],
       "text": "Lleva el nombre de San Pishoy y es famoso por su importancia histórica y religiosa."
      },
      {
       "_key": "000000000008",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "000000000009",
       "_type": "span",
       "marks": [],
       "text": "Aquí tienes una visión general del monasterio: "
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "00000000000c",
     "_type": "block",
     "children": [
      {
       "_key": "00000000000b",
       "_type": "span",
       "marks": [],
       "text": "Ubicación y renombre"
      }
     ],
     "markDefs": [],
     "style": "h3"
    },
    {
     "_key": "00000000000e",
     "_type": "block",
     "children": [
      {
       "_key": "00000000000d",
       "_type": "span",
       "marks": [],
       "text": "Situado como el más oriental de los cuatro monasterios actuales de Wadi El Natrun."
      }
     ],
     "level": 1,
     "listItem": "bullet",
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "000000000013",
     "_type": "block",
     "children": [
      {
       "_key": "00000000000f",
       "_type": "span",
       "marks": [],
       "text": "Es el monasterio más famoso de la Iglesia Ortodoxa "
      },
      {
       "_key": "000000000011",
       "_type": "span",
       "marks": [
        "000000000010"
       ],
       "text": "Copta"
      },
      {
