        "4ib690n3wjmp"
       ],
       "text": "アスワン"
      },
      {
       "_key": "kt23zpt0h5ni",
       "_type": "span",
       "marks": [],
       "text": "の人気観光地のチケット料金"
      }
     ],
     "markDefs": [
      {
       "_key": "4ib690n3wjmp",
       "_type": "internalLink",
       "reference": {
