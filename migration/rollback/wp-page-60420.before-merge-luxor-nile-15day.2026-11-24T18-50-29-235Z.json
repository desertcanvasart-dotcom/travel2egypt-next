     "children": [
      {
       "_key": "000000000000",
       "_type": "span",
       "marks": [],
       "text": "Viaje a Rosetta (Rasheed): Guía para el viajero moderno"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "000000000008",
     "_type": "block",
     "children": [
      {
       "_key": "000000000002",
       "_type": "span",
       "marks": [],
       "text": "Emprender un viaje a Rosetta, también conocida como Rasheed, es un viaje cargado de historia y significado cultural."
      },
      {
       "_key": "000000000003",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "kjhbnahym9sv",
       "_type": "span",
       "marks": [],
       "text": "Tanto si partes de las bulliciosas calles de "
      },
      {
       "_key": "oliioent0i2b",
       "_type": "span",
       "marks": [
        "jmb0juefukn3"
       ],
       "text": "El Cairo"
      },
      {
       "_key": "aaa8l0lp7grs",
       "_type": "span",
       "marks": [],
       "text": " como del encanto mediterráneo de "
      },
      {
       "_key": "nv2j19xt8zz5",
       "_type": "span",
       "marks": [
        "hxs37149hi4e"
       ],
       "text": "Alejandría"
      },
      {
       "_key": "7ijxh4u54hs6",
       "_type": "span",
       "marks": [],
       "text": ", llegar a esta ciudad histórica es un viaje lleno del encanto del "
      },
      {
       "_key": "000000000006",
       "_type": "span",
       "marks": [],
       "text": "Egipto"
      },
      {
       "_key": "000000000007",
       "_type": "span",
       "marks": [],
       "text": " moderno."
      }
     ],
     "markDefs": [
      {
       "_key": "jmb0juefukn3",
       "_type": "internalLink",
       "reference": {
        "_ref": "wp-page-83284",
        "_type": "reference"
       }
      },
      {
       "_key": "hxs37149hi4e",
       "_type": "internalLink",
