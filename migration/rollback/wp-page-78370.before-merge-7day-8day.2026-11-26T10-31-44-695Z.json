       },
       "_type": "externalLink",
       "href": "/es/guide/safaga",
       "newTab": false
      },
      {
       "_key": "000000000036",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/es/patrimonio-mediterraneo-excursion-privada-de-2-dias-a-alejandria-desde-el-cairo/"
       },
       "_type": "externalLink",
