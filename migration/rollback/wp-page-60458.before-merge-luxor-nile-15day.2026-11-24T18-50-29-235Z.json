        "strong"
       ],
       "text": "事前の計画："
      },
      {
       "_key": "000000000027",
       "_type": "span",
       "marks": [],
       "text": " 特にバス旅行では、可能であれば事前に計画し、チケットを購入することをお勧めします。"
      }
     ],
     "level": 1,
     "listItem": "bullet",
