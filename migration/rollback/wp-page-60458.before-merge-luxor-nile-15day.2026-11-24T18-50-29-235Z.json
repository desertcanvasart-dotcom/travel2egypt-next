      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "000000000017",
     "_type": "block",
     "children": [
      {
       "_key": "000000000014",
       "_type": "span",
       "marks": [],
       "text": "For Travelers to/from Dahab or Nuweiba:"
      },
      {
       "_key": "000000000015",
       "_type": "span",
       "marks": [],
       "text": " The Bedouin Bus is a community bus service available for those traveling between Dahab or Nuweiba and St Catherine."
      },
      {
       "_key": "000000000016",
       "_type": "span",
       "marks": [],
       "text": "\n"
      }
