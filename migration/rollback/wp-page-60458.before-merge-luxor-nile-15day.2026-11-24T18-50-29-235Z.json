     "_type": "block",
     "children": [
      {
       "_key": "00000000003b",
       "_type": "span",
       "marks": [
        "strong"
       ],
       "text": "Desde Dahab, Nuweiba o Sharm el Sheij:"
      },
      {
       "_key": "00000000003c",
       "_type": "span",
       "marks": [],
       "text": " Si piensas pasar unos días en Santa Catalina y vienes de estos "
      },
      {
       "_key": "00000000003e",
       "_type": "span",
       "marks": [
        "00000000003d"
       ],
       "text": "lugares"
      },
      {
       "_key": "00000000003f",
       "_type": "span",
       "marks": [],
       "text": ", los taxis son una opción viable."
      },
      {
       "_key": "000000000040",
       "_type": "span",
       "marks": [],
       "text": "Desde Sharm el Sheij, coge un autobús público a Dahab, luego negocia un taxi a Santa Catalina (unas 450 LE "
      },
      {
       "_key": "000000000042",
       "_type": "span",
       "marks": [],
       "text": "por un viaje"
      },
      {
       "_key": "000000000043",
       "_type": "span",
       "marks": [],
       "text": " de ida, unas 2 horas)."
      },
      {
       "_key": "000000000044",
       "_type": "span",
       "marks": [],
       "text": "Desde Nuweiba, el coste y la distancia son similares."
      },
      {
       "_key": "000000000045",
       "_type": "span",
       "marks": [],
       "text": "Un taxi directo de Sharm el Sheij a Santa Catalina puede costar unas 1100 LE."
      }
     ],
