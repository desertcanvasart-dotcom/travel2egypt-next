    {
     "_key": "000000000023",
     "_type": "block",
     "children": [
      {
       "_key": "000000000022",
       "_type": "span",
       "marks": [],
       "text": "A Seamless Egyptian Escapade"
      }
     ],
     "markDefs": [],
     "style": "h3"
    },
    {
     "_key": "000000000028",
     "_type": "block",
     "children": [
      {
       "_key": "000000000024",
       "_type": "span",
       "marks": [],
       "text": "Whether your choice is the steady allure of the bus or the rhythmic charm of the train, traveling to Al Minya is a prelude to the wonders that await in this city of ancient splendor. Each journey option offers its unique perspective of "
      },
      {
       "_key": "000000000026",
       "_type": "span",
       "marks": [
        "000000000025"
       ],
       "text": "Egypt"
      },
      {
       "_key": "000000000027",
       "_type": "span",
       "marks": [],
       "text": ", making the travel as enriching as the destination itself."
      }
     ],
     "markDefs": [
