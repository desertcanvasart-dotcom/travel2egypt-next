     "_type": "block",
     "children": [
      {
       "_key": "00000000002d",
       "_type": "span",
       "marks": [],
       "text": "Para quienes tengan "
      },
      {
       "_key": "00000000002f",
       "_type": "span",
       "marks": [
        "00000000002e"
       ],
       "text": "Luxor"
      },
      {
       "_key": "000000000030",
       "_type": "span",
       "marks": [],
       "text": " en su punto de mira, siete trenes de 1ª y 2ª clase completan diariamente el trayecto de seis a ocho horas."
      },
      {
       "_key": "000000000031",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "000000000032",
       "_type": "span",
       "marks": [],
       "text": "Un viaje a "
      },
      {
       "_key": "000000000034",
       "_type": "span",
       "marks": [
        "000000000033"
