       "marks": [
        "ojwfqlgnkgwu"
       ],
       "text": "Al Minya"
      },
      {
       "_key": "fb8fv57d53pa",
       "_type": "span",
       "marks": [],
       "text": " "
      }
     ],
     "markDefs": [
      {
