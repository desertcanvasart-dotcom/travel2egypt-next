       "marks": [],
       "text": "A continuación, explora "
      },
      {
       "_key": "000000000010",
       "_type": "span",
       "marks": [
        "00000000000f"
       ],
       "text": "la Montaña de Cristal"
      },
      {
       "_key": "000000000011",
       "_type": "span",
       "marks": [],
       "text": ", una extraordinaria maravilla natural adornada con cristales de cuarzo. El "
      },
      {
       "_key": "000000000013",
       "_type": "span",
       "marks": [
        "000000000012"
       ],
       "text": "viaje"
      },
      {
       "_key": "000000000014",
       "_type": "span",
       "marks": [],
       "text": " continúa hacia el Desierto de las Flores, famoso por sus singulares formaciones rocosas en forma de flor. Pasa una noche bajo "
      },
      {
       "_key": "000000000016",
       "_type": "span",
       "marks": [
        "000000000015"
       ],
       "text": "las estrellas en un campamento del desierto"
      },
      {
       "_key": "000000000017",
       "_type": "span",
       "marks": [],
       "text": ", disfrutando de la tranquilidad del desierto egipcio."
      }
     ],
