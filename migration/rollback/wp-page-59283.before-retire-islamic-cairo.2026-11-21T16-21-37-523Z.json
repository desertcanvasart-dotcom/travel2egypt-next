        "00000000001a"
       ],
       "text": "Valle de las Momias Doradas"
      },
      {
       "_key": "00000000001c",
       "_type": "span",
       "marks": [],
       "text": ", donde antiguas tumbas revelan secretos del pasado. Descubre el "
      },
      {
       "_key": "00000000001e",
       "_type": "span",
       "marks": [
        "00000000001d"
       ],
       "text": "Templo de Alejandro Magno"
      },
      {
       "_key": "00000000001f",
