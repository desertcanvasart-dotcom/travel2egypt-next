        "geyt3wjkepp4"
       ],
       "text": "Bahariya Oasis"
      }
     ],
     "markDefs": [
      {
       "_key": "geyt3wjkepp4",
       "_type": "internalLink",
       "reference": {
        "_ref": "wp-page-58769",
