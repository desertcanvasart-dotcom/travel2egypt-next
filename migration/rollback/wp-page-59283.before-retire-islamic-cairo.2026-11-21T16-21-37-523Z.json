      {
       "_key": "000000000036",
       "_type": "span",
       "marks": [],
       "text": "Cada "
      },
      {
       "_key": "000000000038",
       "_type": "span",
       "marks": [
        "000000000037"
       ],
       "text": "excursión por"
      },
      {
       "_key": "000000000039",
       "_type": "span",
       "marks": [],
       "text": " el Oasis de Bahariya es un viaje a través del tiempo y del terreno, que ofrece una rara mezcla de la antigua grandeza de Egipto y la belleza indómita de sus desiertos. Tanto si eres un aficionado a la historia, un buscador de aventuras o simplemente buscas unas vistas sobrecogedoras, el "
      },
      {
       "_key": "00000000003b",
       "_type": "span",
       "marks": [
        "00000000003a"
       ],
       "text": "Oasis de Bahariya"
      },
      {
       "_key": "00000000003c",
       "_type": "span",
       "marks": [],
       "text": " tiene algo que cautivará a cada viajero."
      }
     ],
     "markDefs": [
