       "_key": "00000000001c",
       "_type": "span",
       "marks": [],
       "text": "Dive into our "
      },
      {
       "_key": "00000000001e",
       "_type": "span",
       "marks": [
        "00000000001d"
       ],
       "text": "Egypt Travel Packages"
      },
      {
       "_key": "00000000001f",
       "_type": "span",
