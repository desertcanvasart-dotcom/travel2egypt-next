 },
 "faq": [
  {
   "_key": "faq-usa-1",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b8",
       "_type": "block",
       "children": [
        {
         "_key": "s9",
         "_type": "span",
         "marks": [],
         "text": "Yes. US citizens need a visa to enter Egypt, and tourists can apply for an e-visa or get one on arrival. Conditions and prices can change, so check Egypt’s official e-visa site and US State Department travel information before you go."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do US citizens need a visa for Egypt?"
    }
   ]
  },
  {
   "_key": "faq-usa-2",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "ba",
       "_type": "block",
       "children": [
        {
         "_key": "sb",
         "_type": "span",
         "marks": [],
         "text": "Usually, yes. After a long-haul flight, a night in Cairo before Luxor or Aswan is easier than connecting the same day, when delays and fatigue add up."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Should we stop in Cairo before heading south?"
    }
   ]
  },
  {
   "_key": "faq-usa-3",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "bc",
       "_type": "block",
       "children": [
        {
         "_key": "sd",
         "_type": "span",
         "marks": [],
         "text": "Yes. Christmas, New Year and Easter are peak dates in Egypt. Scheduled departures on those dates usually cost 30% more, and private journeys cost more over the same dates too."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do prices change by season?"
    }
   ]
  }
 ],
 "intro": [
  {
   "_key": "en",
   "value": [
    {
     "_key": "b0",
     "_type": "block",
     "children": [
      {
       "_key": "s1",
       "_type": "span",
       "marks": [],
       "text": "Planning the trip from the USA"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "b2",
     "_type": "block",
     "children": [
      {
       "_key": "s3",
       "_type": "span",
       "marks": [],
       "text": "From around New York, a direct flight to Cairo can be an option. From most other US cities, travellers connect through a European, Middle Eastern or Turkish hub, so check the connection time and the arrival hour, not just the airline."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b4",
     "_type": "block",
     "children": [
      {
       "_key": "s5",
       "_type": "span",
       "marks": [],
       "text": "Plan at least seven nights for Cairo and Luxor. Ten to twelve days lets Cairo, Luxor, Aswan, a Nile cruise and Abu Simbel fit together, and twelve to fourteen leaves room for a few days on the Red Sea."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b6",
     "_type": "block",
     "children": [
      {
       "_key": "s7",
       "_type": "span",
       "marks": [],
       "text": "October to April is the comfortable season. November, February and March balance weather and crowds; December and January are busier and cost more."
      }
     ],
     "markDefs": [],
     "style": "normal"
    }
   ]
  }
 ],
