       "_key": "es9d-6-s0",
       "_type": "span",
       "marks": [
        "strong"
       ],
       "text": "Conexión:"
      },
      {
       "_key": "es9d-6-s1",
       "_type": "span",
       "marks": [],
       "text": " el wifi puede ser limitado en algunos lugares; descarga antes las aplicaciones y la información que necesites."
      }
     ],
     "level": 1,
     "listItem": "bullet",
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "es9d-7",
     "_type": "block",
     "children": [
      {
       "_key": "es9d-7-s0",
       "_type": "span",
       "marks": [
        "strong"
       ],
       "text": "Recogida en el hotel:"
      },
      {
       "_key": "es9d-7-s1",
       "_type": "span",
       "marks": [],
       "text": " espera en el vestíbulo 15 minutos antes de la salida prevista cada día."
      }
     ],
     "level": 1,
