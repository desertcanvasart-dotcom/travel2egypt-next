      {
       "_key": "es9d-5-s0",
       "_type": "span",
       "marks": [
        "strong"
       ],
       "text": "Respeto cultural:"
      },
      {
       "_key": "es9d-5-s1",
       "_type": "span",
       "marks": [],
       "text": " viste con recato al visitar lugares religiosos y prepárate para descalzarte cuando te lo pidan."
      }
     ],
     "level": 1,
     "listItem": "bullet",
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "es9d-6",
     "_type": "block",
