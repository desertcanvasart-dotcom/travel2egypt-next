      }
     ],
     "caption": [
      {
       "_key": "en",
       "value": "\"Overlooking the gentle union between the river and the land, this place offers a tranquil retreat amidst the imposing beauty of nature.\""
      }
     ]
    },
    {
     "_key": "00000000003a",
     "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/08/19_2017-636440933275833543-583.jpg",
     "_type": "image",
