    {
     "_key": "000000000022",
     "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/01/ramses-statues-abu-simble-min.jpg",
     "_type": "image",
     "alt": [
      {
       "_key": "en",
       "value": "Upward view of the towering Ramses II statues at Abu Simbel."
      }
     ],
     "caption": [
