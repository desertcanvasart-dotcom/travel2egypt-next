   "value": [
    {
     "_key": "000000000001",
     "_type": "block",
     "children": [
      {
       "_key": "cyp14c0c4wa7",
       "_type": "span",
       "marks": [],
       "text": "Embarking on Your Journey to "
      },
      {
       "_key": "i9ro79afjh8f",
       "_type": "span",
       "marks": [
        "1muoyijp4h6k"
       ],
       "text": "Kom Ombo"
      },
      {
       "_key": "yz3h6ksqpi3d",
       "_type": "span",
       "marks": [],
       "text": ": Choose Your Path"
      }
     ],
     "markDefs": [
      {
       "_key": "1muoyijp4h6k",
       "_type": "internalLink",
       "reference": {
        "_ref": "wp-page-58875",
        "_type": "reference"
       }
      }
     ],
     "style": "h2"
    },
    {
     "_key": "000000000004",
     "_type": "block",
     "children": [
      {
       "_key": "000000000002",
       "_type": "span",
       "marks": [],
       "text": "Travelers seeking to explore the enchanting town of Kom Ombo are spoiled for choice when it comes to transportation options. Here’s a guide on how to reach this captivating destination:"
      },
      {
       "_key": "000000000003",
       "_type": "span",
       "marks": [],
       "text": "\n"
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "000000000006",
     "_type": "block",
     "children": [
      {
       "_key": "000000000005",
       "_type": "span",
       "marks": [],
       "text": " By Air: Soar Above the Nile"
      }
     ],
     "markDefs": [],
     "style": "h3"
    },
    {
     "_key": "000000000014",
     "_type": "block",
     "children": [
      {
       "_key": "000000000007",
       "_type": "span",
       "marks": [],
       "text": "The bus station, located 3.5 kilometers north of the train station, provides another "
      },
      {
       "_key": "000000000009",
       "_type": "span",
       "marks": [
        "000000000008"
       ],
       "text": "option for travelers"
      },
      {
       "_key": "00000000000a",
       "_type": "span",
       "marks": [],
       "text": ". However, it’s worth noting that the "
      },
      {
       "_key": "00000000000c",
       "_type": "span",
       "marks": [
        "00000000000b"
       ],
       "text": "tourist office discourages bus travel"
      },
      {
       "_key": "00000000000d",
       "_type": "span",
       "marks": [],
       "text": ", considering it somewhat cumbersome. For those undeterred, the Upper Egypt Bus Co operates two daily buses to "
      },
      {
       "_key": "00000000000f",
       "_type": "span",
       "marks": [
        "00000000000e"
       ],
       "text": "Abu Simbel"
      },
      {
       "_key": "000000000010",
       "_type": "span",
       "marks": [],
       "text": ", a four-hour journey that costs E£35. Additionally, there’s a direct bus to "
      },
      {
       "_key": "000000000012",
       "_type": "span",
       "marks": [
        "000000000011"
       ],
       "text": "Cairo"
      },
      {
       "_key": "000000000013",
       "_type": "span",
       "marks": [],
       "text": " departing daily at 6 am and 3 pm, with a travel time of 14 hours."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000008",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/luxor-local-transport-guide/"
       },
       "_type": "externalLink",
