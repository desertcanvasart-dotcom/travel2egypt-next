       "newTab": false
      },
      {
       "_key": "000000000052",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/es/paseo-en-globo-al-amanecer-sobre-los-antiguos-monumentos-de-luxor/"
       },
       "_type": "externalLink",
       "href": "/es/paseo-en-globo-al-amanecer-sobre-los-antiguos-monumentos-de-luxor",
       "newTab": false
