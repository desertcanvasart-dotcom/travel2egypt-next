     "style": "normal"
    },
    {
     "_key": "000000000055",
     "_type": "block",
     "children": [
      {
       "_key": "00000000004c",
       "_type": "span",
       "marks": [],
       "text": "Para quienes busquen una experiencia ferroviaria más lujosa, el Tren Dormido Watania Egypt ofrece dos servicios diarios a "
      },
      {
       "_key": "00000000004e",
       "_type": "span",
       "marks": [
        "00000000004d"
       ],
       "text": "El Cairo"
      },
      {
       "_key": "00000000004f",
       "_type": "span",
       "marks": [],
       "text": ", con salida a las 17 h y a las 19 h."
      },
      {
       "_key": "000000000050",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "000000000051",
       "_type": "span",
       "marks": [],
       "text": " "
      },
      {
       "_key": "000000000053",
       "_type": "span",
       "marks": [
        "000000000052"
       ],
       "text": "Los precios por"
      },
      {
       "_key": "000000000054",
       "_type": "span",
       "marks": [],
       "text": " persona o camarote doble (para dos personas) incluyen cena y desayuno, con tarifas de 60 y 120 dólares estadounidenses, respectivamente. "
      }
     ],
     "markDefs": [
      {
       "_key": "00000000004d",
       "_pendingInternalRef": {
