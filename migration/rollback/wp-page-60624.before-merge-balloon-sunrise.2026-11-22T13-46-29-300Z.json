     ],
     "style": "normal"
    },
    {
     "_key": "000000000016",
     "_type": "block",
     "children": [
      {
       "_key": "000000000015",
       "_type": "span",
       "marks": [],
       "text": " By Train: The Classic Rail Journey"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "00000000001e",
     "_type": "block",
     "children": [
      {
       "_key": "g4m4qz9xy7vf",
       "_type": "span",
       "marks": [],
       "text": "For those who relish the romance of train travel, the "
      },
      {
       "_key": "ip3rjajyzqok",
       "_type": "span",
       "marks": [
        "ijdiwyenolsn"
       ],
       "text": "Aswan"
      },
      {
       "_key": "pe3svek5jnwk",
       "_type": "span",
       "marks": [],
       "text": " Train Station serves as a gateway to "
      },
      {
       "_key": "000000000019",
       "_type": "span",
       "marks": [
        "000000000018"
       ],
       "text": "Kom Ombo"
      },
      {
       "_key": "00000000001a",
       "_type": "span",
       "marks": [],
       "text": ". Multiple daily trains ply the "
      },
      {
       "_key": "00000000001c",
       "_type": "span",
       "marks": [
        "00000000001b"
       ],
       "text": "route northward to Cairo"
      },
      {
       "_key": "00000000001d",
       "_type": "span",
       "marks": [],
       "text": ", departing from 5 am to 9:10 pm. The fare is approximately E£175 for a 14-hour journey. Tickets are recommended to be purchased in advance, but they can also be acquired onboard for an additional E£6."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000018",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/kom-ombo-unforgettable-moments/"
       },
       "_type": "externalLink",
       "href": "/guide/kom-ombo/kom-ombo-unforgettable-moments",
       "newTab": false
      },
      {
       "_key": "00000000001b",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/egypt-travel-faqs/"
       },
       "_type": "externalLink",
       "href": "/faq",
       "newTab": false
      },
      {
       "_key": "ijdiwyenolsn",
       "_type": "internalLink",
       "reference": {
        "_ref": "wp-page-58758",
        "_type": "reference"
       }
      }
     ],
     "style": "normal"
    },
    {
     "_key": "000000000026",
     "_type": "block",
     "children": [
      {
       "_key": "00000000001f",
       "_type": "span",
       "marks": [],
       "text": "The trains that travel north make stops at Daraw (E£22/15, 45 minutes), "
      },
      {
       "_key": "000000000021",
       "_type": "span",
       "marks": [
        "000000000020"
       ],
       "text": "Kom Ombo"
      },
      {
       "_key": "en4p8peztm4h",
       "_type": "span",
       "marks": [],
       "text": " (E£24/17, one hour), "
      },
      {
       "_key": "o3u35eq7rz7v",
       "_type": "span",
       "marks": [
        "dn1k45d4szd3"
       ],
       "text": "Edfu"
      },
      {
       "_key": "rxf116i0r1yq",
       "_type": "span",
       "marks": [],
       "text": " (E£28/19, two hours), "
      },
      {
       "_key": "ilwz9lgtt0eq",
       "_type": "span",
       "marks": [
        "chyk4mbsf85n"
       ],
       "text": "Esna"
      },
      {
       "_key": "mngcbslc55lz",
       "_type": "span",
       "marks": [],
       "text": " (E£38/23, 2½ hours), and "
      },
      {
       "_key": "m48qia5afy72",
       "_type": "span",
       "marks": [
        "64kltnfmyery"
       ],
       "text": "Luxor"
      },
      {
       "_key": "vxqo9kae6t2g",
       "_type": "span",
       "marks": [],
       "text": " (E£45/29, three hours). "
      },
      {
       "_key": "000000000024",
       "_type": "span",
       "marks": [
        "000000000023"
       ],
       "text": "Travelers should note that student"
      },
      {
       "_key": "000000000025",
       "_type": "span",
       "marks": [],
       "text": " discounts are available for all these train routes."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000020",
       "_pendingInternalRef": {
        "sourceLocale": "en",
