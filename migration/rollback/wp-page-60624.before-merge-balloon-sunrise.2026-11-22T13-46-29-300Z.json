       }
      }
     ],
     "style": "normal"
    },
    {
     "_key": "00000000004b",
     "_type": "block",
     "children": [
      {
       "_key": "42skaexlvekk",
       "_type": "span",
       "marks": [],
       "text": "Los trenes que viajan hacia el norte hacen paradas en Daraw (E£22/15, 45 minutos), Kom Ombo (E£24/17, una hora), "
      },
      {
       "_key": "zspyuwag4drr",
       "_type": "span",
       "marks": [
        "6vw3bhtxqugr"
       ],
       "text": "Edfu"
      },
      {
       "_key": "qyxkryzo6l1t",
       "_type": "span",
       "marks": [],
       "text": " (E£28/19, dos horas), "
      },
      {
       "_key": "4p2kz9wc41z8",
       "_type": "span",
       "marks": [
        "dwyp6q8j1dgm"
       ],
       "text": "Esna"
      },
      {
       "_key": "16u061kmlb0r",
       "_type": "span",
       "marks": [],
       "text": " (E£38/23, 2½ horas) y "
      },
      {
       "_key": "000000000044",
       "_type": "span",
       "marks": [
        "000000000043"
       ],
       "text": "Luxor"
      },
      {
       "_key": "000000000045",
       "_type": "span",
       "marks": [],
       "text": " (E£45/29, tres horas)."
      },
      {
       "_key": "000000000046",
       "_type": "span",
       "marks": [],
       "text": "\n"
      },
      {
       "_key": "000000000047",
       "_type": "span",
       "marks": [],
       "text": " Los viajeros deben tener en "
      },
      {
       "_key": "000000000049",
       "_type": "span",
       "marks": [],
       "text": "cuenta"
      },
      {
       "_key": "00000000004a",
       "_type": "span",
       "marks": [],
       "text": " que hay descuentos para estudiantes en todas estas rutas de tren. "
      }
     ],
     "markDefs": [
      {
       "_key": "000000000043",
       "_pendingInternalRef": {
        "sourceLocale": "en",
