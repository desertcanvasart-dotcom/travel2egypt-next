       "marks": [],
       "text": "La batalla de "
      },
      {
       "_key": "up6la5swb65m",
       "_type": "span",
       "marks": [
        "vim73onnvsz5"
       ],
       "text": "Marsa Matruh"
      }
     ],
     "markDefs": [
      {
