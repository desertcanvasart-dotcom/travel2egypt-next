     ],
     "style": "normal"
    },
    {
     "_key": "000000000043",
     "_type": "block",
     "children": [
      {
       "_key": "00000000003f",
       "_type": "span",
       "marks": [],
       "text": "Emprende tu viaje egipcio con estas ideas, y deja que el antiguo encanto de "
      },
      {
       "_key": "000000000041",
       "_type": "span",
       "marks": [
        "000000000040"
       ],
       "text": "El Cairo sea tu guía"
      },
      {
       "_key": "000000000042",
       "_type": "span",
       "marks": [],
       "text": " inolvidable."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000040",
       "_pendingInternalRef": {
        "sourceLocale": "en",
        "wpUrl": "https://travel2egypt.org/es/propinas-en-egipto/"
       },
       "_type": "externalLink",
       "href": "/es/travel-tips/propinas-en-egipto-como-funciona-de-verdad-el-baksheesh",
       "newTab": false
      }
     ],
     "style": "normal"
    },
    {
     "_key": "000000000045",
     "_type": "block",
     "children": [
      {
       "_key": "000000000044",
       "_type": "span",
       "marks": [],
       "text": "Creado el 18 de marzo de 2020"
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "000000000047",
     "_type": "block",
     "children": [
      {
       "_key": "000000000046",
       "_type": "span",
       "marks": [],
       "text": "Actualizado en Ago , 2024"
      }
     ],
     "markDefs": [],
