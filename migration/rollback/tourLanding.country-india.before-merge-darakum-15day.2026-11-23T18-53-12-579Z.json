 "faq": [
  {
   "_key": "faq-india-1",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "b8",
       "_type": "block",
       "children": [
        {
         "_key": "s9",
         "_type": "span",
         "marks": [],
         "text": "Travellers from India can get a visa on arrival in Egypt. Eligibility rules and fees change, so check Egypt’s official e-visa site before you go."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do travellers from India need a visa for Egypt?"
    }
   ]
  },
  {
   "_key": "faq-india-2",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "ba",
       "_type": "block",
       "children": [
        {
         "_key": "sb",
         "_type": "span",
         "marks": [],
         "text": "Usually, yes. After a long journey with a connection, a night in Cairo before heading south is easier than travelling on the same day."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Should we rest in Cairo after arriving?"
    }
   ]
  },
  {
   "_key": "faq-india-3",
   "_type": "landingFaqItem",
   "answer": [
    {
     "_key": "en",
     "value": [
      {
       "_key": "bc",
       "_type": "block",
       "children": [
        {
         "_key": "sd",
         "_type": "span",
         "marks": [],
         "text": "Yes. Christmas, New Year and Easter are peak dates in Egypt. Scheduled departures on those dates usually cost 30% more, and private journeys cost more over the same dates too."
        }
       ],
       "markDefs": [],
       "style": "normal"
      }
     ]
    }
   ],
   "question": [
    {
     "_key": "en",
     "_type": "internationalizedArrayStringValue",
     "value": "Do prices change by season?"
    }
   ]
  }
 ],
 "intro": [
  {
   "_key": "en",
   "value": [
    {
     "_key": "b0",
     "_type": "block",
     "children": [
      {
       "_key": "s1",
       "_type": "span",
       "marks": [],
       "text": "Planning the trip from India"
      }
     ],
     "markDefs": [],
     "style": "h2"
    },
    {
     "_key": "b2",
     "_type": "block",
     "children": [
      {
       "_key": "s3",
       "_type": "span",
       "marks": [],
       "text": "Most flights from India to Egypt connect through Doha, Dubai or Kuala Lumpur. Check the connection time and the arrival hour in Cairo, not just the airline: after a late-night arrival, treat the first day as rest."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b4",
     "_type": "block",
     "children": [
      {
       "_key": "s5",
       "_type": "span",
       "marks": [],
       "text": "Seven days is the shortest trip that connects Cairo with Luxor and Aswan properly. Ten days adds Abu Simbel and time to go deeper at each place."
      }
     ],
     "markDefs": [],
     "style": "normal"
    },
    {
     "_key": "b6",
     "_type": "block",
     "children": [
      {
       "_key": "s7",
       "_type": "span",
       "marks": [],
       "text": "October to April is the comfortable season for sightseeing. December and January are the busiest and cost more."
      }
     ],
     "markDefs": [],
     "style": "normal"
    }
   ]
  }
 ],
