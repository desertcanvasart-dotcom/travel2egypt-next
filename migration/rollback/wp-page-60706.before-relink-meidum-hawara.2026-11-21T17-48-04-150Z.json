   "value": [
    {
     "_key": "000000000001",
     "_type": "block",
     "children": [
      {
       "_key": "mlx21jtnp0cw",
       "_type": "span",
       "marks": [],
       "text": "Únicamente en "
      },
      {
       "_key": "1qlknrhatqm6",
       "_type": "span",
       "marks": [
        "409d8goonzpv"
       ],
       "text": "Marsa Alam"
      },
      {
       "_key": "s1ptam6dlbb4",
       "_type": "span",
       "marks": [],
       "text": " "
      }
     ],
     "markDefs": [
      {
       "_key": "409d8goonzpv",
       "_type": "internalLink",
       "reference": {
