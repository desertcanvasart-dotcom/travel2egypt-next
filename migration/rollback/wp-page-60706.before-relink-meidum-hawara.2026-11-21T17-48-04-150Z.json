       "marks": [
        "nwzdno1p8a7g"
       ],
       "text": "Marsa Alam"
      },
      {
       "_key": "18vdyw3w1juu",
       "_type": "span",
       "marks": [],
       "text": " "
      }
     ],
     "markDefs": [
      {
       "_key": "nwzdno1p8a7g",
