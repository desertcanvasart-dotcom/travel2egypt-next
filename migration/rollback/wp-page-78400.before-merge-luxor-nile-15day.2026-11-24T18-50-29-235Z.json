      {
       "_key": "000000000024",
       "_type": "span",
       "marks": [],
       "text": "Day Five – Desert Safari Adventures"
      }
     ],
     "markDefs": [],
     "style": "h3"
    },
    {
     "_key": "00000000002d",
     "_type": "block",
     "children": [
      {
       "_key": "000000000026",
       "_type": "span",
       "marks": [],
       "text": "Embark on a "
      },
      {
       "_key": "000000000028",
       "_type": "span",
       "marks": [
        "000000000027"
       ],
       "text": "quad bike safari"
      },
      {
       "_key": "000000000029",
       "_type": "span",
       "marks": [],
       "text": " across the desert, or for a more leisurely pace, opt for a horse or camel safari. Witness stunning sunsets and starlit nights. Alternatively, delve deep into the Sahara on a jeep "
      },
      {
       "_key": "00000000002b",
       "_type": "span",
       "marks": [
        "00000000002a"
       ],
       "text": "safari"
      },
      {
       "_key": "00000000002c",
       "_type": "span",
       "marks": [],
       "text": ", perhaps visiting a Bedouin village or the ancient rock inscriptions of Wadi Hammamat."
      }
     ],
     "markDefs": [
      {
       "_key": "000000000027",
       "_pendingInternalRef": {
        "sourceLocale": "en",
