     "children": [
      {
       "_key": "00000000000e",
       "_type": "span",
       "marks": [],
       "text": "Take a day (or two) to "
      },
      {
       "_key": "000000000010",
       "_type": "span",
       "marks": [
        "00000000000f"
       ],
       "text": "explore"
      },
      {
       "_key": "000000000011",
       "_type": "span",
       "marks": [],
       "text": " Luxor, the ancient city of Thebes. Just a few hours’ drive from "
      },
      {
       "_key": "000000000013",
       "_type": "span",
       "marks": [
        "000000000012"
       ],
       "text": "Marsa Alam"
      },
      {
       "_key": "000000000014",
       "_type": "span",
       "marks": [],
       "text": ", Luxor is an open-air museum of Pharaonic Egypt, teeming with temples and historic monuments. Experience local life, wander through bustling souks, and enjoy a "
      },
      {
       "_key": "000000000016",
       "_type": "span",
       "marks": [
        "000000000015"
       ],
       "text": "serene felucca ride"
      },
      {
       "_key": "000000000017",
       "_type": "span",
       "marks": [],
       "text": " on the Nile as the sun sets."
      }
     ],
     "markDefs": [
      {
