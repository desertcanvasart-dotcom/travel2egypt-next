    {
     "_key": "000000000044",
     "_type": "block",
     "children": [
      {
       "_key": "00000000003d",
       "_type": "span",
       "marks": [],
       "text": "Conclude your week with a relaxing "
      },
      {
       "_key": "00000000003f",
       "_type": "span",
       "marks": [
        "00000000003e"
       ],
       "text": "day at the beach"
      },
      {
       "_key": "000000000040",
       "_type": "span",
       "marks": [],
       "text": ". Engage in hotel-organized "
      },
      {
       "_key": "000000000042",
       "_type": "span",
       "marks": [
        "000000000041"
       ],
       "text": "activities"
      },
      {
       "_key": "000000000043",
       "_type": "span",
       "marks": [],
       "text": ", explore local sea life, or unwind in a hammam, indulging in a traditional Middle Eastern soak and scrub."
      }
