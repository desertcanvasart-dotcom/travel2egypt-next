     "_key": "00000000003a",
     "_type": "block",
     "children": [
      {
       "_key": "000000000030",
       "_type": "span",
       "marks": [],
       "text": "Enjoy a night out at the burgeoning "
      },
      {
       "_key": "000000000032",
       "_type": "span",
       "marks": [
        "000000000031"
       ],
       "text": "Port Ghalib marina"
      },
      {
       "_key": "000000000033",
       "_type": "span",
       "marks": [],
       "text": ". "
      },
      {
       "_key": "000000000035",
       "_type": "span",
       "marks": [
        "000000000034"
       ],
       "text": "Savor Egyptian cuisine at seafront restaurants"
      },
      {
       "_key": "000000000036",
       "_type": "span",
       "marks": [],
       "text": " but be cautious with shopping – it’s a high-end area with prices to match. For better shopping deals, "
      },
      {
       "_key": "000000000038",
       "_type": "span",
       "marks": [
        "000000000037"
       ],
       "text": "visit El Quseir or Luxor"
