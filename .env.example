# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# Server-side only — used by Server Components / route handlers to read
# private datasets (e.g. migration-staging). REQUIRED in production when the
# dataset is private; otherwise newly-created docs won't be visible to the
# frontend. Create in Sanity Manage → API → Tokens with role "Viewer".
# Falls back to SANITY_STAGING_API_WRITE_TOKEN / SANITY_API_WRITE_TOKEN in
# dev only — never rely on the fallback in production.
SANITY_API_READ_TOKEN=

# Server-side only — used by seed/migration scripts and any write operations.
# Role: "Editor" or higher. Never expose to the browser.
SANITY_API_WRITE_TOKEN=

# Server-side only — write token scoped to the migration-staging dataset.
# Used by every script under scripts/ that mutates content during migration.
SANITY_STAGING_API_WRITE_TOKEN=

# Cloudinary (optional — fill when ready to migrate images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── AI concierge (/plan-your-tour) ───────────────────────────────────────
# Single go-live/rollback lever. Server-side ONLY — must never become
# NEXT_PUBLIC_ (it would inline at build time and break runtime toggling).
CHAT_ENABLED=false

# Server-side only. Powers the v4.1 concierge chat (Sonnet, pinned in code).
ANTHROPIC_API_KEY=

# Shared site Supabase project; concierge data lives in the dedicated
# `concierge` schema (see supabase/migrations/). Service-role key is
# server-side only and bypasses RLS — never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret signing the t2e_session_id cookie. Long-lived: rotation
# invalidates every live chat session. Generate: openssl rand -hex 32
SESSION_COOKIE_SECRET=

# ── Brief flow + email resume (Session 4) ────────────────────────────────
# Resend API key (transactional email: resume links, S5/S9/S10 later).
# Server-side only — never bundled to the client.
RESEND_API_KEY=

# Separate HMAC secret for stateless 30-day resume tokens. Distinct from
# SESSION_COOKIE_SECRET so rotating one doesn't disturb the other.
# Generate: openssl rand -hex 32
RESUME_TOKEN_SECRET=

# Visitor-facing From address (display name recognizable in the inbox).
EMAIL_FROM="Travel2Egypt Concierge <concierge@travel2egypt.org>"

# Team inbox — Reply-To for concierge mail; brief/escape-hatch destination.
TEAM_INBOX_EMAIL=
