# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-12-01

# Server-side only — used by Server Components / route handlers to read
# private datasets (e.g. migration-staging). REQUIRED in production when the
# dataset is private; otherwise newly-created docs won't be visible to the
# frontend. Create in Sanity Manage → API → Tokens with role "Viewer".
# Falls back to SANITY_STAGING_API_WRITE_TOKEN / SANITY_API_WRITE_TOKEN in
# dev only — never rely on the fallback in production.
SANITY_API_READ_TOKEN=

# Server-side only — used by seed/migration scripts and any write operations.
# Role: "Editor" or higher. Never expose to the browser.
SANITY_API_WRITE_TOKEN=

# Server-side only — write token scoped to the migration-staging dataset.
# Used by every script under scripts/ that mutates content during migration.
SANITY_STAGING_API_WRITE_TOKEN=

# Cloudinary (optional — fill when ready to migrate images)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
