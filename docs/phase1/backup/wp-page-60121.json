            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": " Several bus companies operate services from Cairo and other major "
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [
                "000000000024"
