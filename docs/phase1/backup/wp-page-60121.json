              "text": " International Airport (CAI), which serves as a primary gateway for international "
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [
                "000000000010"
              ],
              "text": "travelers coming into Egypt"
            },
            {
              "_key": "k2npv121ryq8",
              "_type": "span",
              "marks": [],
              "text": ". From "
            },
            {
              "_key": "4796ic8t1if8",
              "_type": "span",
              "marks": [
                "ibhkr55bnvjx"
              ],
              "text": "Cairo"
