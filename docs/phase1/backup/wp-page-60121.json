                "strong"
              ],
              "text": "Private Car or Taxi:"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": " You can hire a private car or taxi from "
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "00000000001b"
              ],
              "text": "Cairo or any major city in Egypt"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": ". The drive to Ismailia from Cairo takes about 1.5 to 2 hours via the Cairo-Ismailia "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "desert"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " road, offering scenic views of the desert landscape transitioning into the green oasis that Ismailia is known for."
            }
