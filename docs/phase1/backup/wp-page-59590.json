              "_type": "externalLink",
              "href": "/es/blog/hoteles-economicos-cerca-de-las-piramides",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000002c",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "Lo "
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "000000000023"
              ],
              "text": "que distingue al Hotel"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": " Horus es su hospitalidad. El personal es conocido por su amabilidad y disposición, "
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [
                "000000000026"
              ],
              "text": "haciendo que los"
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [],
