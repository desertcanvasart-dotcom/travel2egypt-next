                "000000000039"
              ],
              "text": "la historia"
            },
            {
              "_key": "00000000003b",
              "_type": "span",
              "marks": [],
              "text": " y el arte convergen de forma espectacular."
            },
            {
              "_key": "00000000003c",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000003d",
              "_type": "span",
              "marks": [],
              "text": " Cada esquina que se dobla desvela un nuevo descubrimiento, cada puerta conduce a un mundo olvidado, lo "
