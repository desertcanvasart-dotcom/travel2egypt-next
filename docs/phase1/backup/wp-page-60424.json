                "strong"
              ],
              "text": "Rosetta"
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": ", known locally as Rasheed, from the bustling streets of "
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [
                "000000000005"
              ],
              "text": "Cairo"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": " or the coastal allure of "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "Alexandria"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": ", an exceptional day tour awaits, offering a deep dive into the town’s unique Islamic architecture."
            }
          ],
          "markDefs": [
