                "strong"
              ],
              "text": "Rosetta"
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": ", conocida localmente como Rasheed, desde las bulliciosas calles de "
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [
                "000000000005"
              ],
              "text": "El Cairo"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": " o el encanto costero de "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "Alejandría"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": ", les espera una excepcional excursión de un día, que ofrece una inmersión profunda en la singular arquitectura islámica de la ciudad."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000005",
