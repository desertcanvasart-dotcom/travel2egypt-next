        },
        {
          "_key": "00000000003a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [],
              "text": "Each of these "
            },
            {
              "_key": "000000000038",
              "_type": "span",
              "marks": [
                "000000000037"
              ],
              "text": "travel methods to Hurghada"
            },
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [],
              "text": " offers its own unique charm, whether you’re soaring above the clouds, traversing the scenic Egyptian landscape, or gliding across the crystal-clear waters of the Red Sea."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000037",
