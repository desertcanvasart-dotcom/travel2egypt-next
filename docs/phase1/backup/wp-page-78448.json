        },
        {
          "_key": "00000000002a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": "3) Voyage by Sea"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": "For a scenic alternative, consider the fast boat service from "
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [
                "00000000002c"
              ],
              "text": "Sharm El Sheikh"
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [],
              "text": " to Hurghada. This approximately 1 hour and 30-minute "
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [
                "00000000002f"
              ],
              "text": "journey across"
            },
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": " the Red Sea costs around \\$50 for a one-way ticket. Operated by International Fast Ferries, this route "
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [
                "000000000032"
              ],
              "text": "offers a unique"
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": " perspective of Egypt’s stunning coastal landscape."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000002c",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/sharm-el-sheikh-travel-guide/resort-city/"
