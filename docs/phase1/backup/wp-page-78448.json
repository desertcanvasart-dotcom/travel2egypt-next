              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000028",
          "_type": "block",
          "children": [
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": "You can book online "
            },
            {
              "_key": "000000000027",
              "_type": "span",
