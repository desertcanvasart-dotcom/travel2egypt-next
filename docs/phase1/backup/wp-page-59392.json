                "wpUrl": "https://travel2egypt.org/es/souq-bab-el-louk-el-mercado-fresco-de-el-cairo/"
              },
              "_type": "externalLink",
              "href": "/es/blog/souq-bab-el-louk-el-mercado-fresco-de-el-cairo",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000013",
          "_type": "block",
          "children": [
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": "2) Descubre el Antiguo Nilómetro"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000021",
          "_type": "block",
          "children": [
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": "Viaja atrás en el tiempo en el histórico"
            },
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [
                "000000000015"
              ],
              "text": " Nilómetro"
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": ", un notable testimonio del antiguo ingenio egipcio. Construida en el año 861 d.C., esta maravilla arquitectónica fue crucial "
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "000000000018"
              ],
              "text": "para medir el flujo y"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": " reflujo del Nilo. "
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "00000000001b"
              ],
              "text": "Las lecturas del Nilómetro eran fundamentales para"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": " predecir las cosechas y las inundaciones, configurando la vida a lo largo del río. Los "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "visitantes pueden"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " descender por una empinada escalera para presenciar esta antigua herramienta, aún enclavada en la orilla del río, y sentir el pulso de la centenaria civilización egipcia."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000015",
              "_type": "externalLink",
              "href": "https://en.wikipedia.org/wiki/Nilometer",
              "newTab": true
            },
            {
              "_key": "000000000018",
              "_pendingInternalRef": {
                "sourceLocale": "en",
