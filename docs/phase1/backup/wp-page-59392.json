        },
        {
          "_key": "000000000048",
          "_type": "block",
          "children": [
            {
              "_key": "000000000047",
              "_type": "span",
              "marks": [],
              "text": "Creado el 18 de marzo de 2020"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000004a",
