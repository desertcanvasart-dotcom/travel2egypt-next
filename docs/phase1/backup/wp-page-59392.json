            {
              "_key": "4qc92cw6xcdr",
              "_type": "span",
              "marks": [],
              "text": "Things To Do in "
            },
            {
              "_key": "idflwlobdrcu",
              "_type": "span",
              "marks": [
                "b8b7j6ig6ezw"
              ],
              "text": "Cairo"
            }
          ],
          "markDefs": [
            {
              "_key": "b8b7j6ig6ezw",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-83284",
                "_type": "reference"
              }
