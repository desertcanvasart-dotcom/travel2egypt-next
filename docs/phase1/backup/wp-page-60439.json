                "strong",
                "000000000010"
              ],
              "text": "Getting Around"
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": " in Safaga: Effortless and Affordable"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000010",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/akhmim-travel-guide/getting-around/"
