      "children": [
        {
          "_key": "0000000000be",
          "_type": "span",
          "marks": [],
          "text": "si hay habitaciones conectadas o familiares;"
        }
      ],
      "level": 1,
      "listItem": "bullet",
      "markDefs": [],
