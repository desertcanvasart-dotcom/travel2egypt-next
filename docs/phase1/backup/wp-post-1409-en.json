{
  "_createdAt": "2026-04-27T21:47:55Z",
  "_id": "wp-post-1409-en",
  "_rev": "37hNSegHf4NtjSKr1qpoeO",
  "_type": "article",
  "_updatedAt": "2026-07-05T16:13:11Z",
  "author": {
