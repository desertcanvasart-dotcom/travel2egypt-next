            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": "These Adventure Activities offer a blend of adventure, relaxation, cultural immersion, and historical exploration, making"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [
                "000000000024"
              ],
              "text": " St. Catherine"
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " a diverse and enriching destination."
            }
          ],
