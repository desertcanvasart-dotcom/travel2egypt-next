        {
          "_key": "000000000018",
          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Medicinal Plants Project and Fansina Handicrafts:"
            },
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [],
              "text": "Visit projects focusing on the preservation of unique medicinal and aromatic plants found in the region."
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "Learn about these herbs, taste them, and visit the Fansina women’s handicraft project to see traditional and modern Bedouin handicrafts."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Hike & Handicraft in St. Catherine:"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": "Engage in a cultural experience that includes learning local handicrafts from Bedouin women."
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "The trip includes a walk through a valley, a visit to a herbal doctor’s garden, lunch at a Bedouin family house, and a handicraft workshop."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000022",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Mountain Garden Retreats:"
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": "Explore the tranquil and secluded gardens in the high mountains, a tradition dating back to early Byzantine times."
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": "Some gardens have been upgraded for visitor comfort."
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": "Enjoy garden walks at an easy pace, visiting various retreats and other sights of interest."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
