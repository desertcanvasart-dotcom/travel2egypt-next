            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "In St. Catherine, there are a variety of Adventure Activities that cater to different interests, from adventure seekers to those looking to immerse themselves in local culture and "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "history"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": ". Here’s a summary of the major activities you can enjoy in St. Catherine:"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_pendingInternalRef": {
