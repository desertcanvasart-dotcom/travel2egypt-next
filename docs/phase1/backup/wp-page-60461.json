              "_key": "000000000007",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Mountain Trekking:"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "Treks vary in duration, from 1 to 15 days, and can be customized."
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "Trekking options range from 3-8 hours of walking per day."
            },
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [],
              "text": "Equipment and supplies can be carried by camels or trekkers themselves."
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "Accommodation during treks includes tents, Bedouin houses, shelters, or even caves, depending on the season and preferences."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000000e",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/St.-Catherine.jpg",
