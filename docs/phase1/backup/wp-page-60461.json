          "children": [
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Village Tours:"
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [],
              "text": "St. Catherine offers a unique cultural and historical experience."
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": "Tours can include visits to the National Park’s Visitor Center, which has various exhibitions and shows about the area."
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": "A guided tour of the Monastery is also a highlight."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000014",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/Adventure-Activities.jpg",
          "_type": "image",
          "alt": [
