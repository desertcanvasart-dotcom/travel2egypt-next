      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "15414jwg3cqe",
              "_type": "span",
              "marks": [],
              "text": "Discovering "
            },
            {
              "_key": "e8duarhm4uvm",
              "_type": "span",
              "marks": [
                "8pkymgyxhnzv"
              ],
              "text": "the White Monastery"
            },
            {
              "_key": "idp1nn5vz4w1",
              "_type": "span",
              "marks": [],
              "text": ": A Historical Jewel Near "
            },
            {
              "_key": "cz0p93whooaf",
              "_type": "span",
              "marks": [
                "yl475gcibda0"
              ],
              "text": "Sohag"
            }
          ],
          "markDefs": [
            {
              "_key": "8pkymgyxhnzv",
              "_type": "internalLink",
              "reference": {
                "_ref": "guideArticle.sohag.the-white-monastery",
                "_type": "reference"
              }
            },
            {
              "_key": "yl475gcibda0",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58937",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "000000000003",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "For those visiting Sohag, a trip to the White Monastery is an essential experience, showcasing a significant chapter in Egypt’s Christian heritage."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000005",
          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": "Location and Historical Significance"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Situated 12km Northwest of Sohag"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": ": The "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "White Monastery"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": ", perched on rocky terrain above the old flood level of the Nile, is a site of immense historical and spiritual significance."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "000000000008",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/sohag-travel-guide/the-white-monastery/"
              },
              "_type": "externalLink",
              "href": "/guide/sohag/the-white-monastery",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000e",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Founded Around AD 400"
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": ": Established by St. Shenouda, the monastery was dedicated to his mentor, St. Bigol. It’s a symbol of the transition from Egypt’s pagan past to its Christian era."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000010",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": "Architectural Marvel with Ancient Echoes"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000013",
          "_type": "block",
          "children": [
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Reuse of Pharaonic Materials"
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": ": The monastery is notable for its use of white limestone, repurposed from Pharaonic temples. This unique feature allows visitors to glimpse ancient gods and hieroglyphs on some of the blocks, creating a fascinating blend of ancient Egyptian and Christian symbolism."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Once a Thriving Monastic Community"
            },
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": ": In its heyday, the monastery was the center of a vast monastic community and housed Egypt’s largest library. Today, the manuscripts are dispersed globally, and the monastery serves as a home to 23 monks."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000018",
          "_type": "block",
          "children": [
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "Structural Features and Artistic Treasures"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000001b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Fortress-like Walls and Ruined Interiors"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": ": Despite its fortress-like walls, much of the monastery’s interior lies in ruins. However, the church’s basic structure, following a basilica plan with a nave, two side aisles, and a triple apse, is still discernible."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001e",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Intact Nave and Apse"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": ": The intact nave and apses are adorned with beautiful domes, featuring artistic representations of the Dormition of the Virgin and Christ Pantocrator."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000021",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Columns with a Story"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": ": Nineteen columns, sourced from an earlier structure, gracefully separate the side chapels from the nave, each telling a story of the monastery’s evolution through time."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000023",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "A Living Place of Worship"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000026",
          "_type": "block",
          "children": [
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Early Morning Services"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": ": Visitors with a desire to participate in religious services can arrive as early as 4 am. This early start offers a serene and profound experience, connecting guests with the monastery’s spiritual rhythm."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000028",
          "_type": "block",
          "children": [
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "Visiting the White Monastery near Sohag is more than just a tour; it’s a journey through time, where the echoes of ancient Egypt and the early Christian era converge in a remarkable architectural and spiritual legacy."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000029",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/sohag.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "Sohag city skyline with modern buildings and traditional architecture under clear sky"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "A blend of contemporary structures and classic Egyptian design in a bustling city center"
            }
          ]
        },
        {
          "_key": "00000000002a",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/14cf450467039575de2cd264e1e4648d.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "Shafts of sunlight illuminating the vibrant ancient hieroglyphs and carvings on the stone walls between large columns in an Egyptian temple"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Sunlight bridges millennia, casting a serene glow over the enduring legacy of Egyptian hieroglyphics"
            }
          ]
        }
      ]
    },
    {
      "_key": "es",
      "_type": "object",
      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "708ihgbe145a",
              "_type": "span",
              "marks": [],
              "text": "Descubrir "
            },
            {
              "_key": "b0b0iv8gklum",
              "_type": "span",
              "marks": [
                "jeqkrxze22nb"
              ],
              "text": "el Monasterio Blanco"
            },
            {
              "_key": "a6omquw0l0jb",
              "_type": "span",
              "marks": [],
              "text": ": Una joya histórica cerca de "
            },
            {
              "_key": "7ogcs00o3zej",
              "_type": "span",
              "marks": [
                "7htej6meckqm"
              ],
              "text": "Sohag"
            }
          ],
          "markDefs": [
            {
              "_key": "jeqkrxze22nb",
              "_type": "internalLink",
              "reference": {
                "_ref": "guideArticle.sohag.the-white-monastery",
                "_type": "reference"
              }
            },
            {
              "_key": "7htej6meckqm",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58937",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "000000000006",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "Para quienes visiten Sohag, un viaje al Monasterio Blanco es una experiencia esencial, que muestra un capítulo significativo del patrimonio cristiano de "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Egipto"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "http://travel2egypt.org/es/programas-de-viaje-por-egipto/"
              },
              "_type": "externalLink",
              "href": "/es/egypt-travel-packages",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000008",
          "_type": "block",
          "children": [
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "Localización y significado histórico"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Situado a 12 km al noroeste de Sohag"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": ": el Monasterio Blanco, encaramado en un terreno rocoso sobre el antiguo nivel de inundación del Nilo, es un lugar de inmenso significado histórico y espiritual."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000010",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Fundado hacia el año 400 d.C"
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": ".: Fundado por San Shenouda, el monasterio se dedicó a su mentor, San Bigol."
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": " Es un símbolo de la transición del pasado pagano de Egipto a su era cristiana. "
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000012",
          "_type": "block",
          "children": [
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": "Maravilla arquitectónica con ecos antiguos"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000001a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Reutilización de materiales faraónicos"
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": ": El monasterio "
            },
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [
                "000000000015"
              ],
              "text": "destaca"
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": " por su uso de piedra caliza blanca, reutilizada de templos faraónicos."
            },
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [],
              "text": "Esta característica única permite a los visitantes vislumbrar antiguos dioses y jeroglíficos en algunos de los bloques, creando una fascinante mezcla de antiguo simbolismo egipcio y cristiano."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "000000000015",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-suez/destacados/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/guia-de-viaje-de-suez/destacados/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000025",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "En otro "
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [
                "strong",
                "00000000001c"
              ],
              "text": "tiempo fue una"
            },
            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": " próspera comunidad monástica"
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": ": En su apogeo, el monasterio fue el centro de una vasta comunidad monástica y albergó la mayor biblioteca de Egipto."
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": "Hoy, "
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [
                "000000000022"
              ],
              "text": "los manuscritos están dispersos por"
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [],
              "text": " todo el mundo, y el monasterio sirve de hogar a 23 monjes."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "00000000001c",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/el-tiempo-en-egipto/"
              },
              "_type": "externalLink",
              "href": "/es/guide/rosetta-rasheed/el-tiempo-en-rosetta-rashid-y-la-mejor-epoca-para-visitarla",
              "newTab": false
            },
            {
              "_key": "000000000022",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-al-quseir/navega-por-los-viajes/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/guia-de-viaje-de-al-quseir/navega-por-los-viajes/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000027",
          "_type": "block",
          "children": [
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": "Características estructurales y tesoros artísticos"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000032",
          "_type": "block",
          "children": [
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Muros parecidos a los de una fortaleza e interiores en ruinas"
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": ": A pesar de sus muros en forma de fortaleza, gran parte del interior "
            },
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [
                "00000000002a"
              ],
              "text": "del monasterio está"
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": " en ruinas."
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [],
              "text": "Sin embargo, la estructura básica de la iglesia, "
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [
                "00000000002f"
              ],
              "text": "que sigue un plan"
            },
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": " basilical con una nave, dos naves laterales y un ábside triple, sigue siendo discernible."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "00000000002a",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-suez/"
              },
              "_type": "externalLink",
              "href": "/es/guide/suez",
              "newTab": false
            },
            {
              "_key": "00000000002f",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/planifica-tu-viaje/"
              },
              "_type": "externalLink",
              "href": "/es/plan-your-tour",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Nave y ábside intactos"
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": ": La nave y los ábsides intactos están adornados con bellas cúpulas, con representaciones artísticas de la Dormición de la Virgen y Cristo Pantocrátor."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000003b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Columnas con historia"
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": ": Diecinueve columnas, procedentes de una estructura anterior, separan con gracia las capillas laterales de la nave, y cada una cuenta una "
            },
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [
                "000000000038"
              ],
              "text": "historia de la evolución del"
            },
            {
              "_key": "00000000003a",
              "_type": "span",
              "marks": [],
              "text": " monasterio a lo largo del tiempo."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "000000000038",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/explorando-la-gran-esfinge-de-guiza/"
              },
