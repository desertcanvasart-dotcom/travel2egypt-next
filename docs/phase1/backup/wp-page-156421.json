  "body": [
    {
      "_key": "en",
      "_type": "object",
      "value": [
        {
          "_key": "000000000006",
          "_type": "block",
          "children": [
            {
              "_key": "000000000000",
              "_type": "span",
              "marks": [],
              "text": "Discover the timeless treasures of Egypt on this immersive "
            },
            {
              "_key": "000000000001",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "9-Day Egypt Tour of Culture and History"
            },
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": ". Begin in Cairo, where you'll stand in awe of the Great Pyramids of Giza and explore the vast collection of ancient artifacts at the "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Egyptian Museum"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": ". Stroll through the vibrant Khan El Khalili Bazaar and the historic streets of Al-Muizz."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-94643",
                "_type": "reference"
              }
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000e",
          "_type": "block",
          "children": [
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "Fly to Luxor to uncover the wonders of the East and West Banks, including the iconic Valley of the Kings and the magnificent temples of "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "Karnak"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": " and Luxor. Relax aboard a luxurious Nile cruise, sailing to Aswan while visiting remarkable temples like Edfu and "
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [
                "00000000000b"
              ],
              "text": "Kom Ombo"
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": " along the way."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000008",
              "_type": "externalLink",
              "href": "https://en.wikipedia.org/wiki/Karnak",
              "newTab": false
            },
            {
              "_key": "00000000000b",
              "_type": "externalLink",
              "href": "https://en.wikipedia.org/wiki/Kom_Ombo",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": "After exploring "
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [
                "000000000010"
              ],
              "text": "Aswan"
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": "'s Philae Temple, board an overnight train back to Cairo. Complete your journey with visits to Memphis and "
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [
                "000000000013"
              ],
              "text": "Saqqara"
            },
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": ", home to the ancient Step Pyramid, and stroll through Old Cairo's historic sites, including the Hanging Church and Ben Ezra Synagogue. This tour offers a perfect blend of Egypt’s ancient history, culture, and serene landscapes."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000010",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58758",
                "_type": "reference"
