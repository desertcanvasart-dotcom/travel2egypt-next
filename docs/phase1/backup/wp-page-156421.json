          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Conectividade:"
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": " O Wi-Fi pode ser limitado em alguns locais, portanto, certifique-se de ter todos os aplicativos e informações necessários baixados com antecedência."
            }
          ],
          "level": 1,
          "listItem": "bullet",
