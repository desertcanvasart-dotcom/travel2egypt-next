              "_key": "000000000017",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Comfortable Footwear:"
            },
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [],
              "text": " Prepare for extensive walking during tours, especially at archaeological sites."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
