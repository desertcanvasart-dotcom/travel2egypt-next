              "marks": [
                "strong"
              ],
              "text": "Proteção Solar:"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": " Equipe-se com óculos de sol, protetor solar e um chapéu para aproveitar suas excursões sob o sol egípcio."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
