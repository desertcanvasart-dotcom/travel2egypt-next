          "_type": "block",
          "children": [
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Translado do Hotel:"
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " Esteja pronto no saguão do seu hotel 15 minutos antes da partida programada "
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [
                "000000000027"
              ],
              "text": "para as aventuras"
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": " de cada dia."
            }
          ],
          "level": 1,
          "listItem": "bullet",
