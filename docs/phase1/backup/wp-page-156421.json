          "children": [
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Hotel Pickup:"
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [],
              "text": " Be ready in your hotel lobby 15 minutes before your scheduled departure for each day’s adventures."
