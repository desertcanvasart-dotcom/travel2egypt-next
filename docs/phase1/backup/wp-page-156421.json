          "_type": "block",
          "children": [
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Respeito Cultural:"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": " Vista-se modestamente ao "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "visitar locais religiosos e esteja preparado para"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " remover os calçados quando necessário."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "00000000001e",
              "_type": "externalLink",
              "href": "/es/guide/alejandria/el-clima-de-alejandria-y-la-mejor-epoca-para-visitarla",
