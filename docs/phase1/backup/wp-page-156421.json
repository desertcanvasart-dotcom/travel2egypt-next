              "newTab": false
            },
            {
              "_key": "000000000012",
              "_type": "externalLink",
              "href": "/es/blog/explorando-la-gran-esfinge-de-guiza",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
