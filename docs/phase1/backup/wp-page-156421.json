              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Sun Protection:"
            },
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": " Equip yourself with sunglasses, sunscreen, and a hat to enjoy your excursions under the Egyptian sun."
            }
          ],
          "level": 1,
          "listItem": "bullet",
