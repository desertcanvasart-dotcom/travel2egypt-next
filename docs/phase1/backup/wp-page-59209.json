          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000c",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [],
              "text": "A unique fusion of Nubian and Jamaican cuisines, this establishment is celebrated for its flavorful tagines, jerk chicken, and an array of fresh juices. The relaxed ambiance and generous portions make it a favorite among both locals and tourists."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
