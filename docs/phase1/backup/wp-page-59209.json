              ],
              "text": "offers a unique"
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": " dining experience that combines authentic Nubian cuisine with panoramic views of Aswan. Accessible via a complimentary ferry from the dock near the EgyptAir office in downtown Aswan, the journey to the restaurant adds an element of "
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": "adventure"
            },
            {
              "_key": "000000000015",
