                "em"
              ],
              "text": "koshary"
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": " (a mix of rice, lentils, pasta, and fried onions) and "
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [
                "em"
              ],
              "text": "shawarma"
            },
            {
              "_key": "000000000021",
