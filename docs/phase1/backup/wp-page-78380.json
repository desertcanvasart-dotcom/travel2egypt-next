          "_type": "block",
          "children": [
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Nile-Side Dining:"
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": " Some Kom Ombo restaurants boast beautiful views of the Nile. Dining at sunset offers a magical setting, especially after a "
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [
                "000000000028"
              ],
              "text": "day exploring the temple"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": ". Enjoy your meal as "
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [
                "00000000002b"
              ],
              "text": "feluccas"
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": " drift silently by on the water."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "000000000028",
              "_pendingInternalRef": {
