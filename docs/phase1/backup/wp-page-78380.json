        },
        {
          "_key": "000000000047",
          "_type": "block",
          "children": [
            {
              "_key": "00000000003f",
              "_type": "span",
              "marks": [],
              "text": "**"
            },
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Cenar junto al Nilo:**"
            },
            {
              "_key": "000000000041",
              "_type": "span",
              "marks": [],
              "text": " Algunos restaurantes y cafés de Kom Ombo tienen unas vistas impresionantes del Nilo."
            },
            {
              "_key": "000000000042",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000043",
              "_type": "span",
              "marks": [],
              "text": "Cenar aquí por la noche es una experiencia fascinante, ya que disfrutarás de tu comida "
            },
            {
              "_key": "000000000045",
              "_type": "span",
              "marks": [
                "000000000044"
              ],
              "text": "con la puesta de sol del Nilo"
            },
            {
              "_key": "000000000046",
              "_type": "span",
              "marks": [],
              "text": " como telón de fondo."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000044",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/ritmos-del-nilo-el-cairo-cena-crucero-con-danza-del-vientre/"
              },
