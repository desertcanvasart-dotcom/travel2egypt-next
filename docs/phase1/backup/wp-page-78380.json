        {
          "_key": "000000000031",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Nubian Cuisine:"
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [],
              "text": " Kom Ombo’s proximity to Nubia means visitors can explore a culinary tradition distinct from mainstream Egyptian fare. Look for dishes featuring dried okra, hibiscus, spicy stews, and desert truffles—ingredients that tell stories of desert trade and ancient heritage."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [
                "000000000032"
              ],
              "text": "Dining in Kom Ombo"
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": " offers a delightful journey through Egypt’s culinary heritage, with each dish telling a story of its rich culture and history. Whether you’re exploring the ancient ruins or enjoying the scenic beauty of the Nile, the flavors of Kom Ombo are sure to make your visit even more memorable."
            }
          ],
          "markDefs": [
            {
