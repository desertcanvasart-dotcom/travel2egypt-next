        {
          "_key": "000000000014",
          "_type": "span",
          "marks": [],
          "text": "Summer"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "000000000017",
      "_type": "block",
      "children": [
        {
          "_key": "000000000016",
          "_type": "span",
          "marks": [],
          "text": "Hot and dry, with temperatures often exceeding 35°C (95°F) during the day. Nights are cooler, providing some relief."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "000000000019",
      "_type": "block",
      "children": [
        {
          "_key": "000000000018",
          "_type": "span",
          "marks": [],
          "text": "Winter"
        }
      ],
      "markDefs": [],
      "style": "h3"
    },
    {
      "_key": "00000000001b",
      "_type": "block",
      "children": [
        {
          "_key": "00000000001a",
          "_type": "span",
          "marks": [],
          "text": "Mild and somewhat cooler, with daytime temperatures around 18°C (64°F) to 22°C (72°F). Nights can be cool, requiring a light jacket."
        }
      ],
      "markDefs": [],
      "style": "normal"
    },
    {
      "_key": "00000000001d",
      "_type": "block",
      "children": [
        {
          "_key": "jpszvd7uhosz",
          "_type": "span",
          "marks": [],
          "text": "Southern Egypt & the Nile Valley ("
        },
        {
          "_key": "cek7ps7tz6wr",
          "_type": "span",
          "marks": [
            "28clahj1g5f0"
          ],
          "text": "Luxor"
        },
        {
          "_key": "s4d9lhr7io7p",
          "_type": "span",
