          "text": ", "
        },
        {
          "_key": "1hcle9udf1ic",
          "_type": "span",
          "marks": [
            "7syfppz6gkam"
          ],
          "text": "Aswan"
        },
        {
          "_key": "ws9uz24tzbk3",
          "_type": "span",
          "marks": [],
          "text": ")"
        }
      ],
      "markDefs": [
        {
          "_key": "28clahj1g5f0",
          "_type": "internalLink",
          "reference": {
            "_ref": "wp-page-58877",
            "_type": "reference"
          }
        },
        {
          "_key": "7syfppz6gkam",
          "_type": "internalLink",
