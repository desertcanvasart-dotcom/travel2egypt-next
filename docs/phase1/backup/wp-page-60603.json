          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "An aerial view of the Bramous Monastery in Egypt, showcasing two bell towers and a courtyard with a palm tree"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Amidst Egypt's sands, the Bramous Monastery rises with faith and history etched into its walls"
            }
          ]
        },
        {
          "_key": "000000000027",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/wady-el-natron-1.jpg",
          "_type": "image",
