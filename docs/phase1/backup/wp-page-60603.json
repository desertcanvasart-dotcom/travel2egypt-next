            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "encontrar una mezcla de locales de comida rápida conocidos y restaurantes tradicionales que ofrecen auténtica cocina egipcia."
            }
          ],
          "markDefs": [],
          "style": "normal"
