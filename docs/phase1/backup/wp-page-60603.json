          "_type": "block",
          "children": [
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": "Wahet Omar offers a blend of international, Middle Eastern, and Egyptian cuisines. It's a suitable choice for those looking to experience a variety of flavors in a single location."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
