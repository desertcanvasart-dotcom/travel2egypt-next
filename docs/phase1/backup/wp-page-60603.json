          "children": [
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": "Master is a large rest stop that contains a cafe/restaurant and various shops nearby—from fast food to toys, cell phones, and more. It's a convenient stop for travelers seeking a quick bite or to explore local goods."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
