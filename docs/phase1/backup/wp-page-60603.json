          "children": [
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": "Wahet Omar ofrece una combinación de cocina internacional, de Oriente Medio y egipcia. Es una opción adecuada "
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [
                "000000000026"
              ],
              "text": "para quienes desean probar"
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [],
              "text": " una variedad de sabores en un solo lugar."
            }
          ],
          "markDefs": [
            {
