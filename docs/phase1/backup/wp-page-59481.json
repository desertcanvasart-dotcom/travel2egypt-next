              },
              "_type": "externalLink",
              "href": "/es/blog/7-cosas-inolvidables-que-hacer-en-aswan",
              "newTab": false
            },
            {
              "_key": "00000000001b",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-esna/el-tiempo/"
              },
              "_type": "externalLink",
