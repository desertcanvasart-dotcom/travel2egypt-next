              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000026",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": "Al actualizar este relato de viaje, se ha revisado cualquier información obsoleta para reflejar el estado actual "
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [
                "000000000020"
              ],
              "text": "del transporte en el Oasis"
            },
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": " de Dajla. Al embarcarte en tu viaje por esta encantadora parte de Egipto, cada medio de transporte te ofrece no sólo un viaje, sino una ventana a la vida cotidiana y a "
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "000000000023"
              ],
              "text": "la rica historia"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": " de esta extraordinaria región."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000020",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-del-oasis-de-bahariya/sabores-del-oasis-degustacion-del-patrimonio-culinario-del-oasis-de-bahariya/"
