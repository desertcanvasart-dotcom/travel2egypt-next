    "caption": [
      {
        "_key": "en",
        "_type": "object",
        "value": "Bedouin men in white gather cross-legged on woven rugs, clapping through a warm lamplit desert night."
      },
      {
        "_key": "es",
        "_type": "object",
        "value": "Hombres beduinos de blanco se reúnen con las piernas cruzadas sobre alfombras tejidas, aplaudiendo en una cálida noche del desierto iluminada por lámparas."
      },
      {
