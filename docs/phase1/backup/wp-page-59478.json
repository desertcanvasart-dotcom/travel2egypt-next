              },
              "_type": "externalLink",
              "href": "/private-tour-karnak-temple-luxor-temple",
              "newTab": false
            },
            {
              "_key": "1x1w166e6nae",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58854",
                "_type": "reference"
              }
            },
            {
              "_key": "bi65scosomdi",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58877",
                "_type": "reference"
              }
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": "Whether you’re a history enthusiast, a nature lover, or simply seeking a unique adventure, Dakhla Oasis and its surrounding areas offer a plethora of experiences that cater to every interest, each tour a doorway to the rich tapestry of Egypt’s cultural and natural wonders."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000017",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/dakhla-oasis-trips-in-egypt.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "dakhla oasis travel guide"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "The historic minaret of the Nasr El Din Mosque rises over the Dakhla Oasis, embodying the enduring spirit of Egypt's heartland deserts"
            }
          ]
        },
        {
          "_key": "000000000018",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/Dakhla-e1554945660393-1200x900-1.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "dakhla oasis travel guide"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Weathered elegance: a balcony stands defiantly amidst the crumbling relics of a bygone era"
            }
          ]
        },
        {
          "_key": "00000000001b",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [
                "000000000019"
              ],
              "text": "Discover Your Perfect Egypt Travel Packages"
            }
          ],
