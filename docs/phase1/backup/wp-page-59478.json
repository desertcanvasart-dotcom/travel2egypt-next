        {
          "_key": "000000000020",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "Dive into our "
            },
            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [
                "00000000001d"
              ],
              "text": "Egypt Travel"
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": " Packages for the ultimate adventure. Whether you’re dreaming of a Nile cruise, exploring ancient pyramids, or relaxing by the Red Sea, we’ve curated the best experiences for you. Connect your journey seamlessly with our comprehensive travel guide, ensuring every moment is unforgettable."
            }
          ],
