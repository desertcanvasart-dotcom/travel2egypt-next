          "_type": "block",
          "children": [
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Moulid de Mar Girgis (San Jorge)"
            },
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [],
              "text": ": Este festival "
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [
                "000000000033"
              ],
              "text": "copto de una"
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [],
              "text": " semana de duración se celebra en el monasterio de Mar Girgis, en Razagat, y culmina el 11 de noviembre."
            },
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": "A pesar de estar en "
            },
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [
                "000000000038"
              ],
              "text": "una zona restringida para los"
            },
            {
              "_key": "00000000003a",
              "_type": "span",
              "marks": [],
              "text": " extranjeros, atrae a grandes multitudes por su significado religioso y sus festividades culturales."
            }
