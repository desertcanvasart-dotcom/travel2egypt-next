            {
              "_key": "00000000003e",
              "_type": "span",
              "marks": [],
              "text": "Estos actos en Luxor no sólo proporcionan entretenimiento, sino también "
            },
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [
                "00000000003f"
              ],
              "text": "una comprensión más profunda de las"
            },
            {
              "_key": "000000000041",
              "_type": "span",
              "marks": [],
              "text": " costumbres locales, las creencias religiosas y el espíritu comunitario."
            },
            {
              "_key": "000000000042",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000043",
              "_type": "span",
              "marks": [],
              "text": "Ofrecen una excelente oportunidad para que los visitantes se relacionen con la comunidad local y experimenten la verdadera esencia de Luxor más allá de sus antiguas ruinas y templos."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000003f",
