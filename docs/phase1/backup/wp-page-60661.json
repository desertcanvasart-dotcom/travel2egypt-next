              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000030",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Moulids "
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "strong",
                "000000000023"
              ],
              "text": "locales"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": ": En los alrededores de Luxor se celebran varias moulids (celebraciones de santos) más pequeñas, cada una con un encanto único."
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "Entre ellas están las moulids de Abu’l Gumsan cerca de Tariff, del jeque Musa y Abu al-Jud en "
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [
                "000000000028"
              ],
              "text": "Karnak"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": ", del jeque Hamid y del jeque Hussein."
            },
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": "Estos actos ofrecen una visión auténtica "
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [
                "00000000002d"
              ],
              "text": "de las prácticas religiosas y"
            },
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [],
              "text": " culturales locales."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000023",
              "_pendingInternalRef": {
                "sourceLocale": "en",
