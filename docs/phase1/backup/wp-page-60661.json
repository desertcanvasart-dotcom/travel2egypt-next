            {
              "_key": "000000000003",
              "_type": "span",
              "marks": [
                "000000000002"
              ],
              "text": "Luxor"
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": ", con su rico paisaje histórico y cultural, también celebra diversos acontecimientos y festivales que añaden color y vitalidad a la ciudad."
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "He aquí algunos acontecimientos notables en Luxor:"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000002",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "http://travel2egypt.org/es/lo-mejor-que-hacer-en-luxor-egipto/"
              },
              "_type": "externalLink",
              "href": "http://travel2egypt.org/es/lo-mejor-que-hacer-en-luxor-egipto/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000014",
          "_type": "block",
          "children": [
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Moulid de Abu al-Haggag"
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": ": Celebrado en honor del santo patrón de Luxor, Yousef Abu al-Haggag, este festival es uno de los más importantes de Egipto."
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [],
              "text": "Tiene lugar en torno a la "
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [
                "00000000000c"
              ],
              "text": "Mezquita de Abu"
            },
            {
              "_key": "6py3uehv67xx",
              "_type": "span",
              "marks": [],
              "text": " al-Haggag, construida sobre "
            },
            {
              "_key": "ke4b60nh78pl",
              "_type": "span",
              "marks": [
                "xpvs07dlhu55"
              ],
              "text": "el Templo de Luxor"
            },
            {
              "_key": "1quqvtkk22vg",
              "_type": "span",
              "marks": [],
              "text": "."
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [],
              "text": "Este carnaval de cinco días, que tiene "
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [
                "000000000011"
              ],
              "text": "lugar la"
            },
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [],
              "text": " tercera semana antes del Ramadán, presenta música tradicional, danzas y diversas actividades culturales, que reflejan el rico patrimonio de la región."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "00000000000c",
              "_pendingInternalRef": {
