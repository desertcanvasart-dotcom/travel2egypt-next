        },
        {
          "_key": "000000000034",
          "_type": "block",
          "children": [
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": "Aventuras en las Aguas Azules "
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000042",
          "_type": "block",
          "children": [
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [
                "000000000035"
              ],
              "text": "Para los entusiastas de la aventura"
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": " y los aficionados a los deportes acuáticos, Taba Heights es nada menos que un paraíso."
            },
            {
              "_key": "000000000038",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [],
              "text": " La zona es famosa por sus amplias instalaciones para deportes acuáticos, que ofrecen de todo, "
            },
            {
              "_key": "00000000003b",
              "_type": "span",
              "marks": [
                "00000000003a"
              ],
              "text": "desde el sereno buceo con"
            },
            {
              "_key": "00000000003c",
              "_type": "span",
              "marks": [],
              "text": " tubo hasta el emocionante esquí acuático."
            },
            {
              "_key": "00000000003d",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000003e",
              "_type": "span",
              "marks": [],
              "text": " Las aguas claras "
            },
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [
                "00000000003f"
              ],
              "text": "y azules del Mar Rojo son el"
            },
            {
              "_key": "000000000041",
              "_type": "span",
              "marks": [],
              "text": " telón de fondo perfecto para una plétora de actividades acuáticas. "
            }
          ],
          "markDefs": [
            {
