            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": ":"
            },
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": "The safari is flexible and can be tailored to your interests. Whether you’re keen on nature, history, or just a relaxing day out, the trip can be adjusted to suit your preferences."
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "For personalized arrangements, you can contact the organizers at with your preferences and they will provide a price accordingly."
            }
