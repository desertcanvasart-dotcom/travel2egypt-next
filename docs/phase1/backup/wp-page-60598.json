          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Option 1:"
            },
            {
              "_key": "xrba3aq47inl",
              "_type": "span",
              "marks": [],
              "text": " Catch a West & Mid Delta Co bus destined for "
            },
            {
              "_key": "2aybonznzz49",
              "_type": "span",
              "marks": [
                "yltoiwucla8q"
              ],
              "text": "Alexandria"
            },
            {
              "_key": "ji74xfcvhgqi",
              "_type": "span",
              "marks": [],
              "text": ". Request a stop at “Master Mall and Rest” near Wadi Natrun. Expect to pay the full Alexandria fare of around E£120."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
