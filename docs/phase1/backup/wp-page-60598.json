              "_type": "span",
              "marks": [
                "pc7d7i7biifr"
              ],
              "text": "Giza"
            },
            {
              "_key": "b3kahtwt2u29",
              "_type": "span",
              "marks": [],
              "text": ". These cost approximately E£75 and take about one hour."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
