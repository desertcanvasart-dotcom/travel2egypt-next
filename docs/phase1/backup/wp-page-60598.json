            {
              "_key": "uvly67g4nj49",
              "_type": "span",
              "marks": [],
              "text": "への行き方"
            }
          ],
          "markDefs": [
            {
              "_key": "oe0adawhqbvz",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58731",
