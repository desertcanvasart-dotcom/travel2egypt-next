              "_type": "span",
              "marks": [
                "ygzjcs888ddt"
              ],
              "text": "Ras Sudr"
            },
            {
              "_key": "bo0jwipun953",
              "_type": "span",
              "marks": [],
              "text": ": Tu guía para un transporte sin fisuras"
            }
          ],
          "markDefs": [
            {
              "_key": "ygzjcs888ddt",
              "_type": "internalLink",
              "reference": {
