              "marks": [
                "000000000043"
              ],
              "text": "visitantes puedan"
            },
            {
              "_key": "000000000045",
              "_type": "span",
              "marks": [],
              "text": " explorar las diversas atracciones de Al Gouna sin problemas, haciendo que su estancia en la ciudad sea memorable y cómoda."
            }
