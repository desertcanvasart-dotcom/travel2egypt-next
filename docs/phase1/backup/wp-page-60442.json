            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Where land meets sea: a snapshot of outdoor enthusiasts embracing the tranquility of beachside camping"
            }
          ]
        },
        {
          "_key": "00000000001c",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/Kalawy_Magic_Life_01_2008-1.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "A tranquil beach scene with straw umbrellas and sun loungers overlooking a serene lake with rugged mountains in the background"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Serenity by the Water – Unwind in the embrace of nature's quietude"
            }
          ]
        }
