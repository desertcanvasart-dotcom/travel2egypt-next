                "strong"
              ],
              "text": "Dahab"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000020",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/el-desierto-occidental-en-egipto/"
