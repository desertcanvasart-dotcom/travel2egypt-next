            {
              "_key": "000000000049",
              "_type": "span",
              "marks": [],
              "text": "El-Fishawy Café"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000052",
          "_type": "block",
          "children": [
            {
              "_key": "00000000004b",
              "_type": "span",
              "marks": [],
              "text": "Situado en el histórico "
            },
            {
              "_key": "00000000004d",
              "_type": "span",
              "marks": [
                "00000000004c"
              ],
              "text": "bazar de Khan El Khalili"
            },
            {
              "_key": "00000000004e",
              "_type": "span",
              "marks": [],
              "text": ", El-Fishawy es uno de los cafés más antiguos de El Cairo. Abierto las 24 horas del día, es un símbolo cultural donde los "
            },
            {
              "_key": "000000000050",
              "_type": "span",
              "marks": [
                "00000000004f"
              ],
              "text": "visitantes pueden"
            },
            {
              "_key": "000000000051",
              "_type": "span",
              "marks": [],
              "text": " disfrutar de bebidas tradicionales en un entorno lleno de historia."
            }
          ],
