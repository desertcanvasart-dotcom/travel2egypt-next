          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "Cairo’s culinary landscape is a vibrant tapestry of flavors, offering everything from traditional Egyptian dishes to international gourmet experiences. Whether you’re seeking a casual bite or an upscale dining affair, the city caters to all tastes. Here’s a curated list of some of the top restaurants within "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Cairo"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": ":"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
