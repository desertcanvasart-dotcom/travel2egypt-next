              "marks": [],
              "text": "Abou El Sid"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "A quintessential spot for authentic "
            },
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [
                "00000000000a"
              ],
              "text": "Egyptian cuisine"
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": ", Abou El Sid exudes traditional charm. With its vintage decor and classic dishes like molokhia and stuffed vine leaves, it offers a nostalgic journey into Egypt’s culinary heritage."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000000a",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/the-evolution-of-food-in-egypt/"
              },
              "_type": "externalLink",
