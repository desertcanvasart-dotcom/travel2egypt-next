          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000048",
          "_type": "block",
          "children": [
            {
              "_key": "000000000044",
              "_type": "span",
              "marks": [],
              "text": "Ubicado en el "
            },
            {
              "_key": "000000000046",
