              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": "Zooba"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000024",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": "Una versión moderna de la comida callejera egipcia tradicional, Zooba ofrece un ambiente vibrante y reinterpretaciones "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "creativas"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " de clásicos como la taameya (falafel egipcio) y el hawawshi. Es un favorito tanto entre los "
            },
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [
                "000000000021"
              ],
              "text": "lugareños como los turistas"
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": "."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000001e",
              "_pendingInternalRef": {
