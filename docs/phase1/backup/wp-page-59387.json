                "00000000003e"
              ],
              "text": "experiencia única"
            },
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [],
              "text": ", con el encanto añadido de las vistas al río."
            }
          ],
          "markDefs": [
            {
