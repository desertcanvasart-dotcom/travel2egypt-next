              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000f",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "Koshary Abou Tarek"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000014",
          "_type": "block",
          "children": [
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [],
              "text": "Renowned for serving one of "
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [
                "000000000011"
              ],
              "text": "Egypt’s most beloved street foods"
            },
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [],
              "text": ", this establishment specializes in koshary—a hearty mix of rice, pasta, lentils, and crispy onions topped with tangy tomato sauce. It’s a must-visit for an authentic local experience."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000011",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/food-in-kharga-oasis/"
              },
              "_type": "externalLink",
              "href": "/guide/kharga-oasis/food-in-kharga-oasis",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": "Zooba"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000018",
          "_type": "block",
          "children": [
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "A modern twist on traditional Egyptian street food, Zooba offers a vibrant atmosphere and inventive takes on classics like taameya (Egyptian falafel) and hawawshi. It’s a favorite among locals and tourists alike."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [],
              "text": "Sachi"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000001c",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": "Located in Heliopolis, Sachi presents a fusion of Mediterranean and Asian cuisines in a chic setting. Known for its sushi and innovative dishes, it’s a go-to for fine dining enthusiasts."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001e",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": "Kazoku"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000020",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": "Situated in New Cairo, Kazoku offers contemporary Japanese dining with a focus on sushi and robata grill. The sleek ambiance complements its meticulously crafted menu."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000022",
          "_type": "block",
          "children": [
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": "Pier 88"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000024",
          "_type": "block",
          "children": [
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": "Perched on the Nile in Zamalek, Pier 88 combines Italian cuisine with stunning river views. Its elegant setting and diverse menu make it ideal for both casual lunches and romantic dinners."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000026",
          "_type": "block",
          "children": [
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": "Crimson Bar & Grill"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000028",
          "_type": "block",
          "children": [
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "Also in Zamalek, Crimson boasts panoramic views of the Nile alongside a menu that blends international flavors. It’s a popular spot for brunches and evening gatherings."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": "Le Pacha 1901"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000002c",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": "Docked on the Nile, this multi-restaurant venue offers a range of cuisines, including French, Italian, and Asian. Each restaurant within Le Pacha 1901 provides a unique dining experience with the added charm of riverfront views."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002e",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": "Birdcage"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000030",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [],
              "text": "Located in the InterContinental Cairo Semiramis, Birdcage is acclaimed for its authentic Thai cuisine. The serene ambiance and flavorful dishes transport diners straight to Thailand."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000032",
          "_type": "block",
          "children": [
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": "El-Fishawy Café"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000037",
          "_type": "block",
          "children": [
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": "Nestled in the historic "
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [
                "000000000034"
              ],
              "text": "Khan El Khalili bazaar"
            },
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [],
              "text": ", El-Fishawy is one of Cairo’s oldest cafes. Open 24/7, it’s a cultural landmark where visitors can enjoy traditional beverages amidst antique decor."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000034",
              "_type": "externalLink",
              "href": "https://en.wikipedia.org/wiki/Khan_el-Khalili",
              "newTab": true
            }
          ],
          "style": "normal"
        },
