          "_key": "000000000025",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "Situated in the town center, "
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Anwar Restaurant"
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [],
              "text": " is part of the Desert Paradise complex. It offers a variety of local dishes and is known for its friendly service and authentic flavors."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000027",
          "_type": "block",
