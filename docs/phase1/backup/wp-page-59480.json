          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": "Dawia, Shahab, and Abu Zeid Qalamuni Cafe"
