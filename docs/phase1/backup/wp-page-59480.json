              "marks": [
                "strong"
              ],
              "text": "Arabi Restaurant"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": " is a popular spot among locals. It serves a range of Egyptian cuisine, focusing on hearty meals that reflect the oasis’s culinary traditions."
            }
