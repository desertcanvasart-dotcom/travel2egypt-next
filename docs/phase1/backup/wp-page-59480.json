            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "Located on Third Street, "
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Abu Mohamed Restaurant"
