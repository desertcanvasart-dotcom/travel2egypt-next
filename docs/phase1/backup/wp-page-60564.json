  "body": [
    {
      "_key": "en",
      "_type": "object",
      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "9g9jzh5v4mw8",
              "_type": "span",
              "marks": [],
              "text": "Unlocking Adventures in "
            },
            {
              "_key": "ycl8qymedo5g",
              "_type": "span",
              "marks": [
                "c90hwtxkko4o"
              ],
              "text": "Suez"
            },
            {
              "_key": "nknh9f9q4x1h",
              "_type": "span",
              "marks": [],
              "text": ": Gateway to Egypt's Hidden Gems"
            }
          ],
          "markDefs": [
            {
              "_key": "c90hwtxkko4o",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58938",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "00000000000a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "The "
            },
            {
              "_key": "000000000003",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "city of Suez"
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": ", often overshadowed by "
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [
                "000000000005"
              ],
              "text": "Egypt"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "’s more famous tourist destinations, is a hidden treasure waiting to be explored. Known primarily for the "
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Suez Canal"
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": ", this bustling port city holds more than just strategic maritime significance. It’s a place where history, adventure, and stunning natural beauty come together, offering a unique blend of experiences for travelers looking to step off the beaten path."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000005",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/the-definitive-guide-to-egypt-nile-cruise/"
              },
              "_type": "externalLink",
              "href": "/es/blog/the-definitive-guide-to-egypt-nile-cruise",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000014",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [],
              "text": "At the heart of the city lies the "
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Suez Canal"
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": ", a marvel of modern engineering that connects the Mediterranean Sea to the Red Sea. Watching massive ships glide through this vital waterway is a surreal experience. The "
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Suez Canal Authority Building"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": " and the "
            },
            {
              "_key": "2xzxgbove8yn",
              "_type": "span",
              "marks": [
                "strong",
                "6k6zifk4cqys"
              ],
              "text": "Suez Canal House"
            },
            {
              "_key": "gkpjqme1zo2l",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": " Museum"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": " offer fascinating insights into the history and construction of this world-famous canal, tracing its role in global trade and politics. If you’re lucky, you might even catch sight of the "
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "“Ever Given”"
            },
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [],
              "text": "‘s infamous route, which briefly made this canal a household name in 2021."
            }
          ],
          "markDefs": [
            {
              "_key": "6k6zifk4cqys",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-76463",
                "_type": "reference"
              }
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000001c",
          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": "But Suez is more than just its canal. "
            },
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Ain Sokhna"
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": ", a short drive from the city, is a paradise for beach lovers and adventure seekers. Its pristine, crystal-clear waters and soft, sandy beaches are ideal for a relaxing getaway. However, it also offers exciting activities like "
            },
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "snorkeling, diving, and kite surfing"
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [],
              "text": ", where you can explore vibrant coral reefs and colorful marine life. Ain Sokhna is also a gateway to the "
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Galala Mountains"
            },
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": ", perfect for hiking and providing breathtaking views of the Red Sea coastline."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000026",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": "For history buffs, Suez is a treasure trove of ancient and modern landmarks. A short trip to "
            },
            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Mount Sinai"
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [],
              "text": " offers a spiritual journey, where you can follow in the footsteps of pilgrims on the "
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Moses Path"
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": ", reaching the summit for a stunning sunrise view. Closer to the city, the "
            },
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Temples of Serapis"
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": " and "
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Pharaoh’s Bath"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": " (Hammam Pharaon) allow visitors to step back in time to ancient Egypt, where these historical ruins and hot springs offer a mix of adventure and relaxation."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002c",
          "_type": "block",
          "children": [
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "For those interested in modern history, the "
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "October War Panorama Museum"
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": " gives a detailed account of the "
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "1973 Yom Kippur War"
            },
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": ", particularly Egypt’s historic recapture of the Sinai Peninsula. Suez’s pivotal role in the conflict makes it an essential stop for anyone interested in the geopolitics of the region."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000032",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": "Nature lovers can also explore the nearby "
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Wadi El Rayan"
            },
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [],
              "text": " and "
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "El Ein El Sokhna"
            },
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": " nature reserves, offering rich wildlife, rare bird species, and stunning desert landscapes. Whether it’s off-roading in the desert, hiking through rugged terrain, or enjoying a peaceful day by the saltwater lakes, these spots provide plenty of opportunities for outdoor adventures."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000038",
          "_type": "block",
          "children": [
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": "When the sun sets, Suez’s lively waterfront comes alive. The city’s vibrant local markets and seafood restaurants serve up fresh catches of the day, and it’s the perfect time to try authentic Egyptian street food like "
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "koshari"
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [],
              "text": " or "
            },
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "molokhia"
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": " while enjoying the sea breeze."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000003d",
          "_type": "block",
          "children": [
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [],
              "text": "Whether you’re captivated by the history of the Suez Canal, eager to dive into the Red Sea’s clear waters, or looking to explore Egypt’s desert landscapes, "
            },
            {
              "_key": "00000000003b",
              "_type": "span",
              "marks": [
                "00000000003a",
                "strong"
              ],
              "text": "Suez"
            },
            {
              "_key": "00000000003c",
              "_type": "span",
              "marks": [],
              "text": " offers a unique blend of adventure and discovery. Hidden gems are everywhere, just waiting for you to unlock them."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000003a",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/port-said-travel-guide/suez-canal-house/"
              },
              "_type": "externalLink",
              "href": "/guide/suez/suez-canal-house",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000003e",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2019/04/white-desert-formations-1024x680.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "Wind-Crafted White Desert Formations."
            }
          ]
        },
        {
          "_key": "000000000040",
          "_type": "block",
          "children": [
            {
              "_key": "00000000003f",
              "_type": "span",
              "marks": [],
              "text": "A very famous legend says that the temple and later on, the city was named Abu Simble after a local guy who was said led the archaeologists to discover the complex. A trip to Abu Simble is extremely recommended to any tourists who are fond of ancient Egyptian architecture, natural scenery, and Pharaonic history."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000041",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2023/12/Abu_Simbel-front-image.jpg",
          "_type": "image",
