              "value": "abu simble travel guide"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Ancient Stronghold of the Sands: Shali Fortress, Siwa Oasis"
            }
          ]
        },
        {
          "_key": "000000000042",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2023/12/abu-simble-1.jpg",
          "_type": "image",
