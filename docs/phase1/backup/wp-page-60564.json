              "value": "abu simble travel guide"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "abu simble travel guide"
            }
          ]
        }
      ]
    },
    {
      "_key": "es",
      "_type": "object",
      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "z31zb1y6oge7",
              "_type": "span",
              "marks": [],
              "text": "Descubriendo Aventuras en "
            },
            {
              "_key": "reeq3kixi6zw",
              "_type": "span",
              "marks": [
                "vwgh1kxqszi2"
              ],
              "text": "Suez"
            },
            {
              "_key": "8prcs2rgxtb2",
              "_type": "span",
              "marks": [],
              "text": ": La Puerta a los Tesoros Ocultos de Egipto"
            }
          ],
          "markDefs": [
            {
              "_key": "vwgh1kxqszi2",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58938",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "000000000006",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "La ciudad de Suez, a menudo eclipsada por los destinos turísticos más conocidos de Egipto, es un tesoro oculto que espera ser explorado. Conocida principalmente por el Canal de Suez, esta bulliciosa ciudad portuaria tiene mucho más que ofrecer que solo su importancia estratégica en el transporte marítimo. Es un lugar donde la historia, la aventura y la impresionante belleza natural se entrelazan, ofreciendo una mezcla única de "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "experiencias para aquellos viajeros que"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": " buscan salir de los caminos más transitados."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/por-que-deberias-visitar-egipto-en-abril/"
              },
              "_type": "externalLink",
              "href": "/es/blog/por-que-deberias-visitar-egipto-en-abril",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "En el corazón de la ciudad se encuentra el Canal de Suez, una maravilla de la ingeniería moderna que conecta el Mar Mediterráneo con "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "el Mar Rojo"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": ". Ver cómo enormes barcos se deslizan por esta vital vía fluvial es una experiencia surrealista. El edificio de la Autoridad del Canal de Suez y el Museo del Canal de Suez ofrecen una visión fascinante de la historia y la construcción de este canal mundialmente famoso, rastreando su papel en el comercio global y la política. Si tienes suerte, podrías incluso ver la famosa ruta del «Ever Given», que brevemente convirtió al canal en noticia mundial en 2021."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000008",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/excursion-al-antiguo-egipto-y-el-mar-rojo/"
              },
              "_type": "externalLink",
              "href": "/es/egypt-and-the-red-sea",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "Pero Suez es mucho más que su canal. Ain Sokhna, a un corto trayecto en coche desde "
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [
                "00000000000d"
              ],
              "text": "la ciudad, es un paraíso para los amantes de la playa y los buscadores de aventuras"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": ". Sus aguas cristalinas y suaves playas de arena son ideales "
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [
                "000000000010"
              ],
              "text": "para una escapada"
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": " relajante. Sin embargo, también ofrece emocionantes actividades como snorkel, buceo y kitesurf, donde puedes "
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [
                "000000000013"
              ],
              "text": "explorar"
            },
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": " vibrantes arrecifes de coral y una colorida vida marina. Ain Sokhna también es la puerta de entrada a las Montañas de Galala, perfectas para practicar senderismo y disfrutar de impresionantes vistas de la costa del Mar Rojo."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000000d",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/lago-nasser/"
              },
              "_type": "externalLink",
              "href": "/es/blog/lago-nasser",
              "newTab": false
            },
            {
              "_key": "000000000010",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/mujer-viajera-sola-en-egipto/"
              },
              "_type": "externalLink",
              "href": "/es/travel-tips/viajar-sola-a-egipto-el-panorama-real",
              "newTab": false
            },
            {
              "_key": "000000000013",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-nuweiba/explorando/"
              },
              "_type": "externalLink",
              "href": "/es/blog/explorando-la-gran-esfinge-de-guiza",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000021",
          "_type": "block",
          "children": [
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "Para los amantes de la historia, Suez es un verdadero tesoro de "
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "000000000018"
              ],
              "text": "lugares"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": " antiguos y modernos. Un corto "
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "00000000001b"
              ],
              "text": "viaje al Monte Sinaí"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": " ofrece un recorrido espiritual, donde puedes seguir los pasos de los peregrinos en el Camino de Moisés, alcanzando la cumbre para disfrutar de una espectacular vista al amanecer. Más cerca de la ciudad, los "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "Templos de Serapis y el Baño del"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " Faraón (Hammam Pharaon) permiten a los visitantes retroceder en el tiempo al Egipto antiguo, donde estas ruinas históricas y manantiales termales ofrecen una mezcla de aventura y relajación."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000018",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-safaga/lugares/"
              },
              "_type": "externalLink",
              "href": "/es/guide/safaga/lugares-de-safaga",
              "newTab": false
            },
            {
              "_key": "00000000001b",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/ascenso-al-amanecer-del-monte-sinai/"
              },
              "_type": "externalLink",
              "href": "/es/mount-sinai-sunrise-trek-group-day-tour",
              "newTab": false
            },
            {
              "_key": "00000000001e",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-alejandria/el-templo-del-serapeum/"
              },
              "_type": "externalLink",
              "href": "/es/guide/alexandria/el-templo-del-serapeum",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000026",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "Para quienes estén interesados en la historia moderna, el Museo Panorama de la Guerra de Octubre proporciona un relato detallado de la Guerra de Yom Kippur de 1973, en particular la histórica recuperación de la península del Sinaí por parte de "
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "000000000023"
              ],
              "text": "Egipto"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": ". El papel clave de Suez en el conflicto lo convierte en una parada esencial para cualquiera interesado en la geopolítica de la región."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000023",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/the-definitive-guide-to-egypt-nile-cruise/"
              },
              "_type": "externalLink",
              "href": "/es/blog/the-definitive-guide-to-egypt-nile-cruise",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000002b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "Los amantes de la naturaleza también pueden explorar las cercanas reservas naturales de Wadi El Rayan y El Ein El Sokhna, que ofrecen una rica vida silvestre, especies raras de aves y paisajes desérticos impresionantes. Ya sea haciendo off-road en el desierto, caminando por terrenos accidentados o disfrutando "
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [
                "000000000028"
              ],
              "text": "de un día tranquilo junto a los"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": " lagos de agua salada, estos lugares ofrecen muchas oportunidades para aventuras al aire libre."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000028",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/excursion-de-un-dia-a-luxor-desde-hurghada-unete-a-nuestro-recorrido-en-grupo-por-los-sitios-antiguos/"
              },
              "_type": "externalLink",
              "href": "/es/excursion-de-un-dia-a-luxor-desde-hurghada-unete-a-nuestro-recorrido-en-grupo-por-los-sitios-antiguos",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000030",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": "Cuando el sol se pone, el animado paseo marítimo de Suez cobra vida. Los "
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [
                "00000000002d"
              ],
              "text": "mercados locales"
            },
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [],
              "text": " vibrantes y los restaurantes de mariscos sirven las capturas frescas del día, y es el momento perfecto para probar la comida callejera egipcia auténtica, como el koshari o la molokhia, mientras disfrutas de la brisa marina."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000002d",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/7-cosas-inolvidables-que-hacer-en-aswan/"
              },
              "_type": "externalLink",
              "href": "/es/blog/7-cosas-inolvidables-que-hacer-en-aswan",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": "Ya sea que te cautive la historia del "
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [
                "000000000032"
              ],
              "text": "Canal de Suez"
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": ", que estés deseoso de sumergirte en las aguas cristalinas del Mar Rojo o que busques explorar los paisajes desérticos de Egipto, Suez ofrece una combinación única de aventura y descubrimiento. Los tesoros ocultos están en todas partes, esperando a ser descubiertos."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000032",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-port-said/casa-del-canal-de-suez/"
              },
              "_type": "externalLink",
              "href": "/es/guide/suez/casa-del-canal-de-suez",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000036",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2019/04/white-desert-formations-1024x680.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "Wind-Crafted White Desert Formations."
            }
          ]
        },
        {
          "_key": "00000000003d",
          "_type": "block",
          "children": [
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": "Una leyenda muy famosa dice que el templo y, más tarde, la ciudad recibieron el nombre de Abu Simble por un lugareño que, según se dice, llevó a los arqueólogos a descubrir el complejo."
            },
            {
              "_key": "000000000038",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000039",
              "_type": "span",
              "marks": [],
              "text": "Un viaje a Abu Simble es muy recomendable para cualquier turista aficionado a la arquitectura del antiguo Egipto, "
            },
            {
              "_key": "00000000003b",
              "_type": "span",
              "marks": [
                "00000000003a"
              ],
              "text": "los paisajes naturales y la historia faraónica"
            },
            {
              "_key": "00000000003c",
              "_type": "span",
              "marks": [],
              "text": "."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000003a",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/10-dias-por-egipto-y-el-nilo/"
              },
              "_type": "externalLink",
              "href": "/es/authentic-dahabiya-nile-cruise",
              "newTab": false
            }
          ],
          "style": "normal"
        }
      ]
    },
    {
      "_key": "ja",
      "_type": "object",
      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "3n1popf0o499",
              "_type": "span",
              "marks": [
                "ekodo29yntl6"
              ],
              "text": "スエズ"
            },
            {
              "_key": "oay3k2wyir7a",
              "_type": "span",
              "marks": [],
              "text": "で冒険を解き放つ：エジプトの隠れた宝石への玄関口"
            }
          ],
          "markDefs": [
            {
              "_key": "ekodo29yntl6",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58938",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "000000000003",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "有名な観光地に比べてあまり知られていないスエズの街は、実は探訪すべき隠された宝物です。スエズ運河で名高いこの港湾都市には、戦略的な海上交通の重要性だけでなく、歴史、冒険、自然の美が融合した独自の魅力があります。定番ルートを外れた旅を求める方にぴったりの目的地です。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000005",
          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [],
              "text": "スエズ運河：近代工学の驚異"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000007",
          "_type": "block",
          "children": [
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "スエズの中心には、地中海と紅海をつなぐ世界的に有名なスエズ運河があります。巨大な船がゆっくりと水路を進む姿は、まさに幻想的。スエズ運河庁舎やスエズ運河ハウス博物館では、その建設の歴史や世界貿易への影響について深く学ぶことができます。運が良ければ、2021年に話題となった「エバー・ギブン号」の航路に関する展示に出会えるかもしれません。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000009",
          "_type": "block",
          "children": [
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [],
              "text": "アイ ン・ソフナ：海と山に囲まれた楽園"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "スエズから車でわずかのアイ ン・ソフナは、ビーチを愛する人やアドベンチャーを求める人にとっての天国です。透き通った海と白砂のビーチはリラックスに最適で、シュノーケリングやダイビング、カイトサーフィンなどアクティブな海の体験も満喫できます。さらに、ガララ山地への玄関口でもあり、登山や絶景を楽しめます。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "歴史を感じる旅へ"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000f",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "歴史愛好家にとって、スエズは古代と近代のランドマークが点在する宝庫です。少し足を伸ばせば、モーセの道をたどるシナイ山への巡礼路があり、山頂での朝日は格別です。また、セラピス神殿やファラオの風呂（ハンマーム・ファラオン）では、古代エジプトの遺跡や温泉を通して歴史と癒しを同時に体験できます。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000011",
          "_type": "block",
          "children": [
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [],
              "text": "近代史のスポット：1973年戦争パノラマ博物館"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000013",
          "_type": "block",
          "children": [
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": "近代史に興味のある方には、1973年のヨム・キプール戦争とシナイ半島の奪還をテーマにした「10月戦争パノラマ博物館」も見逃せません。スエズはこの戦争で中心的な役割を果たした都市であり、地政学的な観点からも非常に興味深い場所です。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000015",
          "_type": "block",
          "children": [
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": "自然が息づく保護区"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000017",
          "_type": "block",
          "children": [
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [],
              "text": "自然愛好家には、ワディ・エル・ラヤーンやエル・アイン・エル・ソフナ自然保護区がおすすめです。希少な野鳥や野生動物が見られるほか、砂漠の絶景や塩湖の静寂に包まれながらハイキングやオフロード体験も楽しめます。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000019",
          "_type": "block",
          "children": [
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [],
              "text": "夕暮れの海辺とローカルグルメ"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000001b",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": "日が暮れると、スエズの海沿いは活気にあふれます。地元の市場や海鮮レストランでは、その日獲れたばかりの新鮮な魚介類が並びます。心地よい潮風とともに、コシャリやモロヘイヤなど本場のエジプト料理を楽しむ絶好の時間です。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000001d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "あなただけのスエズの冒険を"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000001f",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [],
              "text": "スエズ運河の歴史に魅了されるもよし、紅海の透明な海に飛び込むもよし、あるいは砂漠の絶景を探索するもよし。スエズは、歴史、自然、冒険が織りなす多面的な旅の舞台です。まだ知られていない宝物が、あなたの訪問を待っています。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000021",
          "_type": "block",
          "children": [
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": "補足：風が彫刻したホワイト・デザートの奇岩"
            }
          ],
          "markDefs": [],
          "style": "h4"
        },
        {
          "_key": "000000000023",
          "_type": "block",
          "children": [
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "とても有名な伝説によると、アブ・シンベル神殿とその後にできた町の名前は、考古学者を遺跡に導いたとされる地元の少年「アブ・シンブル」に由来すると言われています。アブ・シンベルは、古代エジプトの建築美と自然、歴史を愛する旅行者にはぜひ訪れてほしい名所です。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000024",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2019/04/white-desert-formations-1024x680.jpg",
          "_type": "image",
          "alt": [
            {
              "_key": "en",
              "value": "Wind-Crafted White Desert Formations."
            }
          ]
        }
      ]
    }
  ],
