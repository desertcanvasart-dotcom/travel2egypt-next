            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": "Este segmento del paseo te permite observar "
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [
                "000000000022"
              ],
              "text": "la singular arquitectura de"
            },
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [],
              "text": " la ciudad y los bulliciosos comercios locales, lo que se suma a la experiencia envolvente de tu llegada."
