          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Train Travel"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "Trains are a highly recommended mode of transportation for moving between cities in this part of Egypt."
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "Offering both comfort and scenic views, they connect major cities and are a reliable way to travel."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
