          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000013",
          "_type": "block",
          "children": [
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Pick-up Taxis"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": "For a more private and direct mode of travel, pick-up taxis are available."
            },
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [],
              "text": "They can be hired for trips within the city or for traveling to nearby areas."
