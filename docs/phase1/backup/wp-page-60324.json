            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Buses"
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "A well-established network of buses connects Qena to other towns and villages."
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "Buses are a cost-effective option and are generally reliable for intra-regional travel."
