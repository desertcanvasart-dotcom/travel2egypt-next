              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000045",
          "_type": "block",
          "children": [
            {
              "_key": "00000000003c",
              "_type": "span",
              "marks": [],
              "text": "El rico tapiz de "
            },
            {
              "_key": "00000000003e",
              "_type": "span",
              "marks": [
                "00000000003d"
              ],
              "text": "historia"
            },
            {
              "_key": "00000000003f",
              "_type": "span",
              "marks": [],
              "text": " de Qena, desde sus raíces griegas y su herencia islámica hasta su importancia actual, la convierte en una ciudad de polifacética importancia cultural e histórica."
            },
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000041",
              "_type": "span",
              "marks": [],
              "text": "Es un testimonio "
            },
            {
              "_key": "000000000043",
              "_type": "span",
              "marks": [
                "000000000042"
              ],
              "text": "del perdurable legado de civilizaciones y culturas"
            },
            {
              "_key": "000000000044",
              "_type": "span",
              "marks": [],
              "text": " que han contribuido a su desarrollo a lo largo de los siglos."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000003d",
              "_pendingInternalRef": {
                "sourceLocale": "en",
