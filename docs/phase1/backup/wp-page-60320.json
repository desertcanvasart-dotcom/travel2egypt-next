              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000012",
          "_type": "block",
          "children": [
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Antiguos comienzos e influencia griega"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "Originalmente llamada Caene (Ciudad Nueva) por los antiguos griegos, distinguiéndola de la cercana "
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [
                "00000000000b"
              ],
              "text": "Coptos"
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": " (actual Qifṭ)."
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "Situada a 23 km al norte de Coptos, poco a poco se hizo cargo "
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [
                "00000000000f"
              ],
              "text": "del importante comercio de esta"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": " última con Arabia, India y China."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "00000000000b",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/los-coptos-de-egipto-guardianes-de-una-antigua-fe/"
