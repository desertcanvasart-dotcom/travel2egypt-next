              ],
              "text": "Qena"
            },
            {
              "_key": "o55taz6xzd4k",
              "_type": "span",
              "marks": [],
              "text": " A Través De La Historia"
            }
          ],
          "markDefs": [
            {
              "_key": "247doa4v7tm4",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58902",
                "_type": "reference"
              }
            }
          ],
          "style": "h2"
        },
        {
          "_key": "000000000008",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "Qena, ciudad impregnada de una mezcla de patrimonio antiguo e islámico, ocupa un lugar importante en la narrativa histórica de "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Egipto"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "."
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "He aquí una exploración de su rico pasado:"
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "http://travel2egypt.org/es/descubre-egipto-en-9-dias-tu-itinerario-de-viaje-definitivo/"
              },
              "_type": "externalLink",
