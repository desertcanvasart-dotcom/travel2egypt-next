{
  "_createdAt": "2026-04-27T21:47:46Z",
  "_id": "wp-post-162340-ja",
  "_rev": "Kra5TYIFOKLIQlRCd8IDaB",
  "_type": "article",
  "_updatedAt": "2026-07-05T16:15:15Z",
  "author": {
