              "marks": [
                "strong"
              ],
              "text": "イベント詳細"
            }
          ],
          "markDefs": [],
          "style": "h4"
        },
        {
          "_key": "000000000027",
          "_type": "block",
          "children": [
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "開催回："
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " 第2回エル・グーナ映画祭（GFF）"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "開催期間："
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": " 2018年9月20日～28日"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "開催地："
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": " エル・グーナ、紅海、エジプト"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "00000000002f",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "まとめ"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000031",
          "_type": "block",
          "children": [
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [],
              "text": "エル・グーナ映画祭は、映画の世界において重要なイベントであり、文化の融合とアラブ映画の発展を重視しています。この映画祭は、新しい才能と創造的表現の場を提供し、特にMENA地域の若手クリエイターを支援することを目的としています。また、映画を通じて異なる文化や世代の架け橋となり、映画制作者や映画愛好家にとって欠かせない場となっています。"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000033",
          "_type": "block",
          "children": [
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [],
              "text": "作成日: 2020年3月18日"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": "更新日: 2025年3月8日"
            }
          ],
