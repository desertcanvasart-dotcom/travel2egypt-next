                "00000000003b"
              ],
              "text": "viaje"
            },
            {
              "_key": "00000000003d",
              "_type": "span",
              "marks": [],
              "text": " al corazón del encanto contemporáneo y el encanto costero de Hurghada."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000003b",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-alejandria/viaje/"
