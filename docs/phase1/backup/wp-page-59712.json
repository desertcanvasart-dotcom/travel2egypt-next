              ],
              "text": "Hurghada"
            },
            {
              "_key": "ldsf7x57urem",
              "_type": "span",
              "marks": [],
              "text": " Marina"
            }
          ],
          "markDefs": [
            {
              "_key": "nuhxcwrkx5cy",
