            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": "Culinary Journey Through Egypt: A Taste of Tradition and Innovation"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "000000000035",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": "Savor the flavors of "
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [
                "00000000002c"
              ],
              "text": "Egypt on a culinary adventure"
            },
            {
              "_key": "00000000002e",
              "_type": "span",
              "marks": [],
              "text": " that spans traditional dishes to contemporary cuisine. From aromatic street food in bustling markets to gourmet dining along the Nile, our guide invites you to feast on the rich tastes of "
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [
                "00000000002f"
              ],
              "text": "Egypt"
            },
            {
              "_key": "000000000031",
              "_type": "span",
              "marks": [],
              "text": ". Click here to "
            },
            {
              "_key": "000000000033",
