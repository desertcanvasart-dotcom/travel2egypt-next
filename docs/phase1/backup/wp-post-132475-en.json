    "_type": "image",
    "alt": "Reed-fringed Nile banks with palm groves and hazy limestone cliffs beyond",
    "asset": {
      "_ref": "image-0c6d86ab3a281efe8e18550d519f8507dd15249e-3000x2002-jpg",
      "_type": "reference"
    },
    "caption": "Green reeds and riverside palms frame the Nile with the Theban hills rising softly in the haze."
  },
