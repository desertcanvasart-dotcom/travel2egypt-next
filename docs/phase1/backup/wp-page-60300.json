            {
              "_key": "00000000001e",
              "_type": "span",
              "marks": [],
              "text": "Microbuses: An Economical and Authentic Experience"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000024",
          "_type": "block",
          "children": [
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": "Microbuses are a common sight in Nuweiba and are an economical way to travel. They operate on fixed routes and are a popular choice among locals. Riding a microbus offers an authentic glimpse into the everyday life of "
            },
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [
                "000000000021"
              ],
              "text": "Nuweiba’s residents and is perfect for travelers"
            },
            {
              "_key": "000000000023",
              "_type": "span",
              "marks": [],
              "text": " on a budget."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000021",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/things-to-do-in-nuweiba/"
              },
              "_type": "externalLink",
