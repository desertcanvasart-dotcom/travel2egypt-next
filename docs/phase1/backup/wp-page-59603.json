              },
              "_type": "externalLink",
              "href": "/es/travel-tips/propinas-en-egipto-como-funciona-de-verdad-el-baksheesh",
              "newTab": false
            },
            {
              "_key": "000000000029",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/visita-a-esna-edfu-y-kom-ombo/"
              },
              "_type": "externalLink",
              "href": "/es/esna-edfu-kom-ombo-temples-group-day-tour-from-luxor",
              "newTab": false
            },
            {
              "_key": "00000000002c",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/el-kab-y-el-templo-de-esna-desde-asuan/"
              },
              "_type": "externalLink",
              "href": "/es/de-asuan-a-el-kab-y-edfu-un-dia-entre-la-dinastia-xviii-y-el-ultimo-templo-en-funcionamiento",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000034",
          "_type": "block",
          "children": [
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [],
              "text": "La Kaysariya, un callejón cubierto de tiendas, era el corazón del "
            },
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [
                "000000000031"
              ],
              "text": "mercado local"
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": ". Durante la época de Mohamed Ali, creció la importancia de Esna, conocida por sus hermosas casas y una próspera fábrica de tarboush."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000031",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/7-cosas-inolvidables-que-hacer-en-aswan/"
              },
              "_type": "externalLink",
