              },
              "_type": "externalLink",
              "href": "/es/blog/7-cosas-inolvidables-que-hacer-en-aswan",
              "newTab": false
            },
            {
              "_key": "000000000039",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-al-quseir/navega-por-los-viajes/"
