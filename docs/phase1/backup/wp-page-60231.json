                "strong"
              ],
              "text": "Day Tour to El-Alamein "
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Marsa Matruh: A Historical Hub"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "Marsa Matruh, a city drenched in history and strategically positioned along the Mediterranean, stands as a beacon for those intrigued by the past. It offers a variety of tours that not only captivate tourists but also deeply engage "
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [
                "000000000007"
              ],
              "text": "history"
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": " enthusiasts. Among these, the "
            },
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [
                "00000000000a"
              ],
              "text": "Day Tour"
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": " to El-Alamein is particularly noteworthy, providing an immersive exploration into the pivotal events of World War II."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000007",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/guardian-of-time-exploring-the-great-sphinx-of-giza/"
              },
              "_type": "externalLink",
              "href": "/blog/giza-no-dai-sufinkusu",
              "newTab": false
            },
            {
              "_key": "00000000000a",
              "_pendingInternalRef": {
