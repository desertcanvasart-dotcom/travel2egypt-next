              "marks": [
                "strong"
              ],
              "text": "Attend the Moulid Abd El-Rahim Al Qenawi"
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "This is a religious festival in honor of the Sufi saint Abd El-Rahim Al Qenawi."
            },
            {
              "_key": "00000000000d",
              "_type": "span",
              "marks": [],
              "text": "The event features spiritual activities, cultural performances, and a vibrant display of local traditions."
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "It’s a unique experience that allows you to immerse yourself in the local culture and spirituality."
            }
          ],
          "level": 1,
          "listItem": "number",
