          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Visit "
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [
                "strong",
                "000000000005"
              ],
              "text": "the Temple of Dendera"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "The Temple of Dendera is the crown jewel of Qena and a must-visit site."
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [],
              "text": "This well-preserved temple is dedicated to the goddess Hathor and showcases stunning ancient Egyptian architecture and art."
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "The temple complex offers a glimpse into Egypt’s rich religious and cultural history."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000005",
              "_pendingInternalRef": {
