              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "Kamona – A Taste of Egypt"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "000000000012",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [],
              "text": "Situated on "
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [
                "00000000000f"
              ],
              "text": "Alexandria"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": " Street, Kamona is renowned for its authentic Egyptian cuisine. The restaurant features a spacious two-floor layout adorned with oriental decorations, creating a warm and inviting atmosphere. Diners can savor a variety of grilled meats, including kofta, kebab, and liver, complemented by traditional sides. Kamona is a favorite among locals and tourists alike for its flavorful dishes and friendly service. ."
            }
          ],
          "markDefs": [
            {
              "_key": "00000000000f",
              "_type": "externalLink",
              "href": "https://en.wikipedia.org/wiki/Alexandria",
              "newTab": true
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000014",
          "_type": "block",
          "children": [
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [],
              "text": "Morgana – Mediterranean Delights"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": "Set in Almaza Bay, Morgana specializes in Mediterranean cuisine, offering a menu rich with regional flavors. Guests can dine alfresco, enjoying dishes like grilled seafood and fresh salads, all while taking in the picturesque surroundings. The restaurant’s elegant ambiance and attentive service make it a must-visit for those seeking a refined dining experience."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000018",
          "_type": "block",
          "children": [
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "Makai Tukai – Fusion with a View"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "00000000001a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [],
              "text": "Also located in Almaza Bay, Makai Tukai offers an Asian fusion dining experience. The restaurant’s menu includes sushi, teppanyaki, and other Far Eastern specialties, all crafted with a modern twist. The stylish interior and coastal views make it a popular choice for dinner."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
