              "text": "Dining & Restaurants in "
            },
            {
              "_key": "j9zx6u4ue8ra",
              "_type": "span",
              "marks": [
                "du0gb8c4ttk6"
              ],
              "text": "Marsa Matruh"
            }
          ],
          "markDefs": [
            {
              "_key": "du0gb8c4ttk6",
