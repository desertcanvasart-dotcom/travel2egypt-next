        {
          "_key": "000000000004",
          "_type": "block",
          "children": [
            {
              "_key": "000000000003",
              "_type": "span",
              "marks": [],
              "text": "Explore the diverse culinary landscape of Marsa Matruh, where coastal charm meets a variety of dining experiences. From fresh seafood to traditional Egyptian dishes and international flavors, the city’s restaurants cater to every palate."
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000006",
          "_type": "block",
          "children": [
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": "Corallo – A Seafood Lover’s Dream"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "Located within the Jaz Crystal Resort in Almaza Bay, "
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "000000000008"
              ],
              "text": "Corallo"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": " offers an exquisite seafood dining experience. Guests can enjoy a variety of dishes prepared with the freshest ingredients, all while taking in stunning views of the Mediterranean Sea. The restaurant is known for its elegant setting and attentive service, making it a perfect spot for both lunch and dinner. e."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000008",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/marsa-matruh-travel-guide/culinary-journey/"
              },
