                "000000000024"
              ],
              "text": "visitantes"
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " una estancia íntima rodeada de belleza natural. Su ubicación privilegiada, a solo 3 km del emblemático "
            },
