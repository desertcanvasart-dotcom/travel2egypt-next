            {
              "_key": "60srhsycx6gt",
              "_type": "span",
              "marks": [],
              "text": "St. Catherine is not only famous for the historic "
            },
            {
              "_key": "40qh0c2igp2a",
              "_type": "span",
              "marks": [
                "fy2qjqs1380h"
              ],
              "text": "Saint Catherine"
            },
            {
              "_key": "sp1jcwyh021j",
              "_type": "span",
              "marks": [],
              "text": "’s Monastery but also serves as the gateway to the breathtaking Mount Sinai hikes. It offers an opportunity to explore ancient trails, experience vibrant Bedouin culture, and marvel at the extraordinary natural beauty of this UNESCO World Heritage site."
            }
          ],
          "markDefs": [
            {
              "_key": "fy2qjqs1380h",
              "_type": "internalLink",
              "reference": {
                "_ref": "wp-page-58925",
