    {
      "_key": "es",
      "_type": "object",
      "value": [
        {
          "_key": "000000000001",
          "_type": "block",
          "children": [
            {
              "_key": "000000000000",
              "_type": "span",
              "marks": [],
              "text": "Sólo en Luxor"
            }
          ],
          "markDefs": [],
          "style": "h2"
        },
        {
          "_key": "000000000008",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "El Museo de la Momificación de "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Luxor"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": " es un destino apasionante para los interesados en la antigua cultura egipcia, especialmente en sus prácticas funerarias y creencias sobre el más allá."
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [],
              "text": "Ofrece una visión única del proceso de momificación, un aspecto central de las costumbres funerarias egipcias."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "http://travel2egypt.org/es/lo-mejor-que-hacer-en-luxor-egipto/"
              },
              "_type": "externalLink",
              "href": "http://travel2egypt.org/es/lo-mejor-que-hacer-en-luxor-egipto/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000000a",
          "_type": "block",
          "children": [
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "Lo más destacado del Museo de la Momificación:"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "00000000000d",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Comprender la momificación"
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": ": El museo educa a los visitantes sobre la creencia de los antiguos egipcios en la conservación del cuerpo para la otra vida, haciendo hincapié en el proceso de momificación y su importancia cultural."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000015",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Exposiciones"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": ": Alberga una colección variada, que incluye momias, herramientas utilizadas en la momificación, tarros canopos y diversas sustancias empleadas en el proceso, como el natrón."
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": "El museo también presenta representaciones visuales de las tumbas, "
            },
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [
                "000000000012"
              ],
              "text": "que ilustran los"
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": " pasos de la momificación."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000012",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-al-fayoum/la-piramide-de-al-lahun/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/guia-de-viaje-de-al-fayoum/la-piramide-de-al-lahun/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000001b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Momias de animales"
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": ": Uno de los aspectos más intrigantes es su exposición de "
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "000000000018"
              ],
              "text": "momias de animales,"
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [],
              "text": " que pone de relieve la práctica de los egipcios de momificar animales, que a menudo se asociaban con los dioses."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000018",
              "_type": "externalLink",
              "href": "https://es.wikipedia.org/wiki/Momificaci%C3%B3n_de_animales",
              "newTab": true
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000023",
          "_type": "block",
          "children": [
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Momias y ataúdes"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": ": Los "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "visitantes pueden"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " ver momias de distintas épocas, incluido el ataúd de Padi-Amun, bellamente elaborado."
            },
            {
              "_key": "000000000021",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000022",
              "_type": "span",
              "marks": [],
              "text": "La exposición del ataúd de Masaharti, un sumo sacerdote, es especialmente notable."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "00000000001e",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/vacaciones-inolvidables-en-egipto/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/vacaciones-inolvidables-en-egipto/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "00000000002b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000024",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Creencias funerarias"
            },
            {
              "_key": "000000000025",
              "_type": "span",
              "marks": [],
              "text": ": El museo profundiza en la creencia de los egipcios en el más allá, mostrando cómo consideraban que la supervivencia del cuerpo era esencial para el "
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [
                "000000000026"
              ],
              "text": "viaje"
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [],
              "text": " del alma."
            },
            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": "Esto se refleja en sus elaboradas prácticas funerarias."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000026",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/guia-de-viaje-de-alejandria/viaje/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/guia-de-viaje-de-alejandria/viaje/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000031",
          "_type": "block",
          "children": [
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Aprendizaje interactivo"
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": ": La disposición del museo y sus exposiciones informativas lo convierten en una atractiva experiencia de aprendizaje, especialmente para los fascinados por la "
            },
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [
                "00000000002e"
              ],
              "text": "historia y la cultura del"
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [],
              "text": " antiguo Egipto."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "00000000002e",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/explorando-la-gran-esfinge-de-guiza/"
              },
              "_type": "externalLink",
              "href": "https://travel2egypt.org/es/explorando-la-gran-esfinge-de-guiza/",
              "newTab": false
            }
          ],
          "style": "normal"
        },
        {
          "_key": "000000000037",
          "_type": "block",
          "children": [
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Entorno arquitectónico"
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": ": Situado bajo tierra junto al Nilo, proporciona un ambiente único que resuena con el tema del inframundo y "
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [
                "000000000034"
              ],
              "text": "la vida de"
            },
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [],
              "text": "spués de la muerte de la mitología egipcia."
            }
          ],
          "level": 1,
          "listItem": "number",
          "markDefs": [
            {
              "_key": "000000000034",
