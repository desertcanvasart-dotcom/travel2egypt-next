              "marks": [],
              "text": "Conclusión:"
            }
          ],
          "markDefs": [],
          "style": "h3"
        },
        {
          "_key": "000000000049",
          "_type": "block",
          "children": [
            {
              "_key": "000000000040",
              "_type": "span",
              "marks": [],
              "text": "Visitar el Museo de la Momificación de "
            },
            {
              "_key": "000000000042",
              "_type": "span",
              "marks": [
                "000000000041"
              ],
              "text": "Luxor"
            },
            {
              "_key": "000000000043",
              "_type": "span",
              "marks": [],
              "text": " es algo más que una visita; es una exploración de las profundidades de una de las civilizaciones más antiguas del mundo."
            },
            {
              "_key": "000000000044",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000045",
              "_type": "span",
              "marks": [],
              "text": "Ofrece una visión exhaustiva de los meticulosos procesos y las arraigadas creencias asociadas con la muerte y el más allá en el antiguo "
            },
            {
              "_key": "000000000047",
              "_type": "span",
