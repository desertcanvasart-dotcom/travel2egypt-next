            {
              "_key": "en",
              "value": "An obelisk with hieroglyphic engravings against a twilight sky"
            }
          ],
          "caption": [
            {
              "_key": "en",
              "value": "Timeless Scripts - The enduring legacy of Egyptian hieroglyphs etched onto an obelisk"
            }
          ]
        },
        {
          "_key": "000000000038",
          "_pendingImage": "https://travel2egypt.org/wp-content/uploads/2024/03/kristina-tamasauskaite-pvfS65ySVXY-unsplash-1.jpg",
