              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "スキューバダイビング："
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "紅海の美しいサンゴ礁、多様な海洋生物、魅力的な沈没船を探索。"
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
