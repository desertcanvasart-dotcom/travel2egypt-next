              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Los manglares: Una maravilla costera"
            }
          ],
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000010",
          "_type": "block",
          "children": [
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Extensos manglares:"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": " Una de las características más distintivas de Nabq es su bosque de manglares de 4 km de longitud."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [],
          "style": "normal"
        },
        {
          "_key": "000000000016",
          "_type": "block",
          "children": [
            {
              "_key": "000000000012",
              "_type": "span",
              "marks": [
                "000000000011"
              ],
              "text": "Adaptación única: Los"
            },
            {
              "_key": "000000000013",
              "_type": "span",
              "marks": [],
              "text": " manglares, un tipo de vegetación anfibia, prosperan en las zonas llanas y arenosas de las costas tropicales."
            },
            {
              "_key": "000000000014",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [],
              "text": "Sus raíces pedunculadas, tanto sumergidas como emergiendo del agua, forman una densa red."
            }
          ],
          "level": 1,
          "listItem": "bullet",
          "markDefs": [
            {
              "_key": "000000000011",
              "_pendingInternalRef": {
                "sourceLocale": "en",
                "wpUrl": "https://travel2egypt.org/es/la-electricidad-en-egipto/"
              },
              "_type": "externalLink",
