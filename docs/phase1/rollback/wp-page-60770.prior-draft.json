        {
          "_key": "00000000000b",
          "_type": "block",
          "children": [
            {
              "_key": "000000000002",
              "_type": "span",
              "marks": [],
              "text": "El Parque Nacional de Nabq, situado a lo largo de la costa entre "
            },
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "000000000003"
              ],
              "text": "Dahab"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [],
              "text": " y "
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [
                "000000000006"
              ],
              "text": "Sharm El-Sheikh"
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [],
              "text": ", es una notable mezcla de ecosistemas desérticos y marinos."
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": "Declarado zona de conservación en 1992, abarca una superficie de 600 km² y es famoso por sus características naturales únicas y su biodiversidad."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000003",
