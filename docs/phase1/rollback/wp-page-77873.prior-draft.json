          "_type": "block",
          "children": [
            {
              "_key": "000000000015",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Rica historia y cultura:"
            },
            {
              "_key": "000000000016",
              "_type": "span",
              "marks": [],
              "text": " Más allá de su belleza natural, Marsa Matruh está impregnada de historia."
            },
            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [],
              "text": "La proximidad de la ciudad al antiguo "
            },
            {
              "_key": "00000000001a",
              "_type": "span",
              "marks": [
                "000000000019"
              ],
              "text": "Oasis de Siwa aporta una"
            },
            {
              "_key": "00000000001b",
              "_type": "span",
              "marks": [],
              "text": " mezcla de culturas e historias."
            },
            {
              "_key": "00000000001c",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000001d",
              "_type": "span",
              "marks": [],
              "text": "La Capilla "
            },
            {
              "_key": "00000000001f",
              "_type": "span",
              "marks": [
                "00000000001e"
              ],
              "text": "Copta"
            },
            {
              "_key": "000000000020",
              "_type": "span",
              "marks": [],
              "text": " y el Museo del Escondite de Rommel, un intrigante búnker subterráneo utilizado durante la II Guerra Mundial, son testimonios del diverso pasado de la región."
            }
