        {
          "_key": "000000000039",
          "_type": "block",
          "children": [
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Serenidad sin igual:"
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": " Lo que realmente distingue a Marsa Matruh es su ambiente tranquilo."
            },
            {
              "_key": "000000000034",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [],
              "text": "A diferencia de los destinos turísticos más masificados, Marsa Matruh ofrece una escapada pacífica, "
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [
                "000000000036"
              ],
              "text": "por lo que es"
            },
            {
              "_key": "000000000038",
              "_type": "span",
              "marks": [],
              "text": " un lugar ideal para quienes buscan relajarse y tomar el sol mediterráneo en un entorno más sereno."
            }
          ],
          "markDefs": [
            {
              "_key": "000000000036",
              "_pendingInternalRef": {
                "sourceLocale": "en",
