              ],
              "text": "local, sumérgete en los bulliciosos mercados"
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " de Marsa Matruh."
            },
            {
              "_key": "000000000027",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000028",
              "_type": "span",
              "marks": [],
              "text": "El zoco Al-Hamam ofrece "
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [
                "000000000029"
              ],
              "text": "una gran variedad de productos tradicionales egipcios"
            },
            {
              "_key": "00000000002b",
              "_type": "span",
              "marks": [],
              "text": ", desde vibrantes tejidos hasta aromáticas especias."
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000002d",
              "_type": "span",
              "marks": [],
              "text": "No pierdas la oportunidad de saborear la cocina local, especialmente el marisco, que es una "
            },
            {
              "_key": "00000000002f",
              "_type": "span",
              "marks": [
                "00000000002e"
              ],
              "text": "delicia culinaria"
            },
            {
              "_key": "000000000030",
              "_type": "span",
              "marks": [],
              "text": ", recién llegado del Mediterráneo."
            }
