        },
        {
          "_key": "00000000003c",
          "_type": "block",
          "children": [
            {
              "_key": "000000000032",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Arrecife Panorama:"
            },
            {
              "_key": "000000000033",
              "_type": "span",
              "marks": [],
              "text": " Este lugar de buceo es un "
            },
            {
              "_key": "000000000035",
              "_type": "span",
              "marks": [
                "000000000034"
              ],
              "text": "espectáculo de vida marina"
            },
            {
              "_key": "000000000036",
              "_type": "span",
              "marks": [],
              "text": ", conocido por sus bancos de barracudas, juguetones delfines, elegantes rayas águila y el avistamiento ocasional de tiburones grises de arrecife y de punta plateada."
            },
            {
              "_key": "000000000037",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "000000000038",
              "_type": "span",
              "marks": [],
              "text": "El arrecife ofrece una gama de profundidades de 3 m a 40 m, lo "
            },
            {
              "_key": "00000000003a",
              "_type": "span",
              "marks": [
                "000000000039"
              ],
              "text": "que lo convierte en un"
            },
            {
              "_key": "00000000003b",
              "_type": "span",
              "marks": [],
              "text": " lugar emocionante para buceadores intermedios, accesible sólo en barco."
            }
          ],
