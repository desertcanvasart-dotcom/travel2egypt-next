              "_key": "000000000025",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Opción más rápida:"
            },
            {
              "_key": "000000000026",
              "_type": "span",
              "marks": [],
              "text": " Para los que buscan velocidad, también se pueden alquilar motos."
