              "_type": "span",
              "marks": [],
              "text": "."
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Rental Options:"
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [],
              "text": " Available from most hotels and shops in the town center. For better quality, consider renting from bicycle repair shops."
            },
            {
              "_key": "000000000009",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Advantages:"
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [],
              "text": " Biking allows for a leisurely exploration of the area at your own pace."
            }
          ],
          "level": 1,
