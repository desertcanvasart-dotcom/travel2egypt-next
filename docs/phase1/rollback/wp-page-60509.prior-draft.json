          "_type": "block",
          "children": [
            {
              "_key": "000000000004",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Bicicletas"
            },
            {
              "_key": "000000000005",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Ideal para explorar:"
            },
            {
              "_key": "000000000006",
              "_type": "span",
              "marks": [],
              "text": " Las bicicletas son una forma popular y ecológica de recorrer el Oasis de Siwa."
            },
            {
              "_key": "000000000007",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Opciones de alquiler:"
            },
            {
              "_key": "000000000008",
              "_type": "span",
              "marks": [],
              "text": " Disponibles en la mayoría de los "
            },
            {
              "_key": "00000000000a",
              "_type": "span",
              "marks": [
                "000000000009"
              ],
              "text": "hoteles"
            },
            {
              "_key": "00000000000b",
              "_type": "span",
              "marks": [],
              "text": " y tiendas del centro de la ciudad."
            },
            {
              "_key": "00000000000c",
              "_type": "span",
              "marks": [],
              "text": "\n"
            },
            {
              "_key": "00000000000e",
              "_type": "span",
              "marks": [
                "00000000000d"
              ],
              "text": "Para una mejor"
            },
            {
              "_key": "00000000000f",
              "_type": "span",
              "marks": [],
              "text": " calidad, considera la posibilidad de alquilarlas en tiendas de reparación de bicicletas."
            },
            {
              "_key": "000000000010",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Ventajas:"
            },
            {
              "_key": "000000000011",
              "_type": "span",
              "marks": [],
              "text": " La bicicleta permite explorar la zona sin prisas y a tu propio ritmo."
            }
