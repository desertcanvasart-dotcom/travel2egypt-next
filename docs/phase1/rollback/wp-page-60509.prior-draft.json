              "marks": [
                "strong"
              ],
              "text": "Ideal for Exploring:"
            },
            {
              "_key": "9w37j120zx7w",
              "_type": "span",
              "marks": [],
              "text": " Bicycles are a popular and eco-friendly way to navigate "
            },
