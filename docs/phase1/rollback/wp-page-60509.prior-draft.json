            {
              "_key": "000000000029",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Consideraciones:"
            },
            {
              "_key": "00000000002a",
              "_type": "span",
              "marks": [],
              "text": " "
            },
            {
              "_key": "00000000002c",
              "_type": "span",
              "marks": [
                "00000000002b"
              ],
              "text": "Las motos ofrecen menos tranquilidad que"
            },
            {
              "_key": "00000000002d",
