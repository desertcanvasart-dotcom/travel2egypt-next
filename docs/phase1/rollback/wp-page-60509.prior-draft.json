            {
              "_key": "000000000017",
              "_type": "span",
              "marks": [],
              "text": "Los carros tirados por"
            },
            {
              "_key": "000000000018",
              "_type": "span",
              "marks": [],
              "text": " burros son un medio de transporte común y tradicional para los lugareños."
            },
            {
              "_key": "000000000019",
              "_type": "span",
              "marks": [
                "strong"
              ],
              "text": "Experiencia única:"
            },
            {
              "_key": "00000000001a",
